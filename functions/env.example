# Copy to functions/.env (or functions/.env.<projectId>) before `firebase deploy --only functions`.
# These are NON-secret settings for the Meta WhatsApp Cloud API phone-OTP flow.
# Secrets are NOT stored in files: set them with
#   firebase functions:secrets:set META_WA_ACCESS_TOKEN --project <projectId>
#   firebase functions:secrets:set OTP_PEPPER           --project <projectId>
# (OTP_PEPPER: any long random string, e.g. `openssl rand -base64 48`.)
#
# Leave META_WA_PHONE_NUMBER_ID / META_WA_TEMPLATE_NAME empty to keep phone
# sign-in switched off; the rest of authentication works without them.

# The WhatsApp Business "phone number ID" (from Meta App → WhatsApp → API setup).
META_WA_PHONE_NUMBER_ID=
# Name of an APPROVED authentication-category template whose body takes the code as {{1}}.
META_WA_TEMPLATE_NAME=
META_WA_TEMPLATE_LANG=en
# Graph API version to call; check Meta's changelog before bumping.
META_WA_API_VERSION=v21.0
# true when the template has a copy-code / one-tap button (needs the code as the button parameter).
META_WA_TEMPLATE_BUTTON=true
# Country code assumed for bare 10-digit mobile numbers.
DEFAULT_PHONE_COUNTRY_CODE=91
