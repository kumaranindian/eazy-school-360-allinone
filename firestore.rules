rules_version = '2';

// Multi-tenant core ruleset — Milestones 0–6 (hardened during validation).
//
// Tenant isolation is enforced with a "lookup table" pattern: every rule
// that needs to know who the caller is reads the caller's OWN
// /users/{request.auth.uid} profile via get(). No custom claims and no
// Cloud Functions are involved — see SECURITY_ARCHITECTURE.md →
// "Custom claims vs. lookup rules".
//
// Self-signup (a brand-new account creating a school and becoming its
// SCHOOL_ADMIN) is ONE atomic batch. The three writes in that batch
// cross-check each other with getAfter()/existsAfter(), which see the
// state the batch would produce — so a profile can only claim a school
// that the same caller is creating in the same batch, and never an
// existing one.
//
// There is no `allow read, write: if true` anywhere, and the fallback at
// the bottom default-denies anything not explicitly matched.
// Executable proof: firestore-tests/rules.test.mjs.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Caller identity ---------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function schoolPath(schoolId) {
      return /databases/$(database)/documents/schools/$(schoolId);
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath(request.auth.uid));
    }

    function callerProfile() {
      return get(userPath(request.auth.uid)).data;
    }

    function callerRole() {
      return callerProfile().role;
    }

    function callerSchoolId() {
      return callerProfile().schoolId;
    }

    function callerBranchId() {
      return callerProfile().branchId;
    }

    // ---- Per-branch roles (multi-branch staff) ------------------------------
    // A profile has a home branch (`branchId` + `role`). Staff who also work in
    // other branches carry `branchRoles: { <branchId>: <role> }`, written only
    // by Cloud Functions (setBranchAccess / provisioning), never by a client.
    // The role the caller holds IN a branch is the home role there, the mapped
    // role elsewhere, and null (no access) otherwise. Missing data grants nothing.
    function branchRoleOf(p, branchId) {
      let r = p.get('branchRoles', {}).get(branchId, null);
      return p.branchId == branchId ? p.role
        : (r in ['BRANCH_ADMIN', 'TEACHER', 'FINANCE'] ? r : null);
    }

    function callerRoleIn(branchId) {
      return branchRoleOf(callerProfile(), branchId);
    }

    // ACTIVE caller of this school holding [role] in this branch.
    function callerIsInBranchAs(schoolId, branchId, role) {
      return isActiveCaller() && callerSchoolId() == schoolId && callerRoleIn(branchId) == role;
    }

    // ACTIVE caller of this school holding any role in this branch.
    function callerWorksInBranch(schoolId, branchId) {
      return isActiveCaller() && callerSchoolId() == schoolId && callerRoleIn(branchId) != null;
    }

    // School admins and branch-scoped staff (home or per-branch role) of the
    // school — not parents.
    function isSchoolStaffOf(schoolId) {
      return isSchoolAdminOrAbove(schoolId)
        || (isActiveCaller() && callerSchoolId() == schoolId
            && (callerRole() in ['BRANCH_ADMIN', 'TEACHER', 'FINANCE']
                || callerProfile().get('branchRoles', {}).size() > 0));
    }

    // ---- Student transfer between branches ---------------------------------
    // One batch (school admin only) that: creates the student in the new
    // branch (same id, `transferredFrom`), marks the old record TRANSFERRED
    // (`transferredTo`) and writes the audit entry in schools/{s}/studentTransfers.
    // Each side checks the other with getAfter(), so neither a forged
    // "transferred from" nor a one-sided hand-off can be written.
    function studentPath(schoolId, branchId, studentId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/students/$(studentId);
    }

    // [d] is the NEW record in branch [branchId]; its source must be, after the
    // batch, a TRANSFERRED record pointing back at it.
    function transferDestinationOk(schoolId, branchId, studentId, d) {
      let from = d.transferredFrom;
      let src = studentPath(schoolId, from.branchId, from.studentId);
      return isSchoolAdminOf(schoolId)
        && from.keys().hasOnly(['branchId', 'studentId', 'admissionNumber'])
        && from.branchId is string && from.studentId is string && from.branchId != branchId
        && d.status == 'ACTIVE'
        && existsAfter(src)
        && getAfter(src).data.status == 'TRANSFERRED'
        && getAfter(src).data.transferredTo.branchId == branchId
        && getAfter(src).data.transferredTo.studentId == studentId;
    }

    // [d] is the SOURCE record after the change: now TRANSFERRED to a record
    // that the same batch creates in the other branch.
    function transferSourceOk(schoolId, branchId, studentId, before, d) {
      let to = d.transferredTo;
      let dest = studentPath(schoolId, to.branchId, to.studentId);
      return isSchoolAdminOf(schoolId)
        && before.status == 'ACTIVE' && !('transferredTo' in before)
        && d.status == 'TRANSFERRED'
        && to.keys().hasOnly(['branchId', 'studentId', 'admissionNumber'])
        && to.branchId is string && to.studentId is string && to.branchId != branchId
        && !exists(dest)
        && existsAfter(dest)
        && getAfter(dest).data.transferredFrom.branchId == branchId
        && getAfter(dest).data.transferredFrom.studentId == studentId;
    }

    // A branch academic year is the branch's copy of an ACTIVE school-wide
    // year: same id, same name and dates, and it says which one it is.
    function branchYearMatchesSchoolYear(schoolId, yearId, d) {
      let sy = /databases/$(database)/documents/schools/$(schoolId)/academicYears/$(yearId);
      return exists(sy)
        && get(sy).data.status == 'ACTIVE'
        && d.get('schoolYearId', null) == yearId
        && d.name == get(sy).data.name
        && d.startDate == get(sy).data.startDate
        && d.endDate == get(sy).data.endDate;
    }

    // A profile existing is not enough — status must be ACTIVE. INVITED
    // and DISABLED accounts are denied everything except reading (and
    // nothing else on) their own profile.
    // (Kept deliberately small: this is expanded into most rules in the file,
    // and the whole ruleset must stay under the service's release limit. The
    // profile is read once and the sign-in method derived once.)
    function isActiveCaller() {
      return hasProfile() && activeAndAllowed(callerProfile());
    }

    // ---- Login access (authentication feature) ----------------------------
    // /users/{uid}.login is written only by Cloud Functions (admin SDK):
    //   { enabled, methods[], effective[], phone?, ... }
    // `effective` = the user's permitted methods ∩ the school's enabled
    // methods. A profile WITHOUT `login` is a legacy account and keeps working
    // exactly as before. The sign-in provider of the current token must be in
    // `effective`, so a disabled user or a disabled method is refused on every
    // read/write immediately, even though the Firebase Auth account (and any
    // unexpired ID token) still exists.
    function signInMethod() {
      let p = request.auth.token.firebase.sign_in_provider;
      return p == 'password' ? 'PASSWORD'
        : p == 'google.com' ? 'GOOGLE'
        : (p == 'custom' && request.auth.token.get('via', '') == 'PHONE_OTP') ? 'PHONE_OTP'
        : 'OTHER';
    }

    // [p] is the caller's own profile. ACTIVE, and the login grant (if any)
    // permits the token's sign-in method. Mirrors storage.rules loginAllowed().
    function activeAndAllowed(p) {
      let l = p.get('login', null);
      let m = signInMethod();
      return p.status == 'ACTIVE' && (l == null || (
        l.enabled == true
        && m in l.effective
        // A Google sign-in is only accepted for the Google account whose
        // verified email is the one registered on the profile.
        && (m != 'GOOGLE'
          || (request.auth.token.get('email_verified', false) == true
            && request.auth.token.get('email', '').lower() == p.get('email', '')))
      ));
    }

    function isPlatformAdmin() {
      return hasProfile() && isPlatformAdminP(callerProfile());
    }

    function isPlatformAdminP(p) {
      return activeAndAllowed(p) && p.role == 'PLATFORM_ADMIN';
    }

    function isSchoolAdminOf(schoolId) {
      return hasProfile() && isSchoolAdminOfP(callerProfile(), schoolId);
    }

    function isSchoolAdminOfP(p, schoolId) {
      return activeAndAllowed(p) && p.role == 'SCHOOL_ADMIN' && p.schoolId == schoolId;
    }

    function isBranchAdminOf(schoolId, branchId) {
      return hasProfile() && isBranchAdminOfP(callerProfile(), schoolId, branchId);
    }

    function isBranchAdminOfP(p, schoolId, branchId) {
      return activeAndAllowed(p) && p.schoolId == schoolId
        && branchRoleOf(p, branchId) == 'BRANCH_ADMIN';
    }

    function isSchoolAdminOrAbove(schoolId) {
      return hasProfile() && schoolAdminOrAboveP(callerProfile(), schoolId);
    }

    function schoolAdminOrAboveP(p, schoolId) {
      return activeAndAllowed(p) && (p.role == 'PLATFORM_ADMIN'
        || (p.role == 'SCHOOL_ADMIN' && p.schoolId == schoolId));
    }

    function isSameSchool(schoolId) {
      return hasProfile() && activeAndAllowed(callerProfile())
        && callerSchoolId() == schoolId;
    }

    // ---- Academic setup (Milestone 2) ----------------------------------
    //
    // SCHOOL_ADMIN/PLATFORM_ADMIN manage any branch in their school;
    // BRANCH_ADMIN manages only their own branch; TEACHER/FINANCE get
    // read-only access to their own branch's configuration; PARENT gets
    // none of this (brief §22) — deliberately absent from the role list
    // below rather than relying on a negative check.
    // One ACTIVE-caller check for the whole "admin of this branch, or one of
    // [roles] in this branch" family (kept as one expression so the helpers
    // below do not each expand isActiveCaller() several times).
    //   PLATFORM_ADMIN: always; SCHOOL_ADMIN: their school;
    //   others: their own school + branch and a role listed in [roles].
    function staffScope(schoolId, branchId, roles) {
      return hasProfile() && staffScopeOf(callerProfile(), schoolId, branchId, roles);
    }

    function staffScopeOf(p, schoolId, branchId, roles) {
      return activeAndAllowed(p) && (p.role == 'PLATFORM_ADMIN'
        || (p.schoolId == schoolId && (p.role == 'SCHOOL_ADMIN'
          || branchRoleOf(p, branchId) in roles)));
    }

    function canManageAcademicSetup(schoolId, branchId) {
      return staffScope(schoolId, branchId, ['BRANCH_ADMIN']);
    }

    function canViewAcademicSetup(schoolId, branchId) {
      return staffScope(schoolId, branchId, ['BRANCH_ADMIN', 'TEACHER', 'FINANCE']);
    }

    // ---- Student + Parent management (Milestone 3) ---------------------
    //
    // Same manage/view split as academic setup. [canAccessAsParent] is
    // the separate, relationship-based path brief §36 requires: a PARENT
    // never gets a general "view students" grant (deliberately absent
    // from canViewStudentData below) — they can only read a specific
    // student if an ACTIVE, portal-enabled parentLinks record names them.
    function canManageStudentData(schoolId, branchId) {
      return staffScope(schoolId, branchId, ['BRANCH_ADMIN']);
    }

    // Branch-wide view of students/parents: admins and finance. A TEACHER is
    // deliberately absent: a teacher reads only the students of the sections
    // they are ASSIGNED to (teacherHasSection / teacherOfStudent below),
    // never the whole branch.
    function canViewStudentData(schoolId, branchId) {
      return staffScope(schoolId, branchId, ['BRANCH_ADMIN', 'FINANCE']);
    }

    // ---- Teacher scope (teacherAccess) ------------------------------------
    // teacherAccess/{uid} is written only by Cloud Functions from the
    // teacher's ACTIVE teacherAssignments (functions/teacher_access.js):
    //   sectionKeys: ['classId__sectionId', ...]
    // Rules cannot query assignments, so this index is the trusted summary.
    // Missing document ⇒ no access (never a fallback to branch-wide).
    function teacherAccessPath(schoolId, branchId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /teacherAccess/$(request.auth.uid);
    }

    // The caller is an ACTIVE teacher of this school+branch assigned to the
    // section. Judged on the record's own class/section (list queries must pin
    // both equalities).
    function teacherHasSection(schoolId, branchId, classId, sectionId) {
      return callerIsInBranchAs(schoolId, branchId, 'TEACHER')
        && classId is string && sectionId is string
        && exists(teacherAccessPath(schoolId, branchId))
        && (classId + '__' + sectionId) in get(teacherAccessPath(schoolId, branchId)).data.sectionKeys;
    }

    // The student is currently placed in a section the caller teaches.
    function teacherOfStudent(schoolId, branchId, studentId) {
      let st = get(/databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /students/$(studentId)).data;
      return teacherHasSection(schoolId, branchId, st.get('currentClassId', null), st.get('currentSectionId', null));
    }

    // The parent has a child in a section the caller teaches (parentAccess is
    // the rules-readable list of the family's section keys).
    function teacherOfParent(schoolId, branchId, parentId) {
      let pa = /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /parentAccess/$(parentId);
      return callerIsInBranchAs(schoolId, branchId, 'TEACHER')
        && exists(teacherAccessPath(schoolId, branchId)) && exists(pa)
        && get(pa).data.sectionKeys.hasAny(get(teacherAccessPath(schoolId, branchId)).data.sectionKeys);
    }

    function parentLinkPath(schoolId, branchId, studentId, parentId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /students/$(studentId)/parentLinks/$(parentId);
    }

    // True only for a signed-in, active PARENT whose own /users profile is
    // linked to a Parent record that has an ACTIVE, portal-enabled
    // parentLinks entry for THIS specific student. Three narrow checks, not
    // a role grant — see docs/milestone-3-student-parent-management.md →
    // "Parent data security".
    function canAccessAsParent(schoolId, branchId, studentId) {
      let linkedParentId = callerProfile().linkedParentId;
      let linkPath = parentLinkPath(schoolId, branchId, studentId, linkedParentId);
      return isActiveCaller()
        && callerRole() == 'PARENT'
        && callerSchoolId() == schoolId
        && linkedParentId != null
        && exists(linkPath)
        && get(linkPath).data.canAccessPortal == true
        && get(linkPath).data.status == 'ACTIVE';
    }

    // ---- Staff + Teacher management (Milestone 4) ---------------------
    //
    // Same manage/view split as students, with two differences:
    //  * TEACHER gets NO general staff read (only their OWN record and
    //    their OWN assignments) — a teacher role is not a licence to
    //    browse colleagues' personal data.
    //  * FINANCE may read staff in their own branch (groundwork for
    //    payroll), but never write.
    // Designation is descriptive only and appears nowhere below: access
    // follows the caller's /users role, never a job title.
    function canManageStaff(schoolId, branchId) {
      return staffScope(schoolId, branchId, ['BRANCH_ADMIN']);
    }

    function canViewStaff(schoolId, branchId) {
      return staffScope(schoolId, branchId, ['BRANCH_ADMIN', 'FINANCE']);
    }

    function departmentPath(schoolId, branchId, departmentId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/departments/$(departmentId);
    }

    function designationPath(schoolId, branchId, designationId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/designations/$(designationId);
    }

    function sectionPath(schoolId, branchId, academicYearId, classId, sectionId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /academicYears/$(academicYearId)/classes/$(classId)/sections/$(sectionId);
    }

    function classSubjectPath(schoolId, branchId, academicYearId, classId, subjectId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /academicYears/$(academicYearId)/classes/$(classId)/classSubjects/$(subjectId);
    }

    function staffPath(schoolId, branchId, staffId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/staff/$(staffId);
    }

    function staffCodePath(schoolId, branchId, codeLower) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/staffCodes/$(codeLower);
    }

    function assignmentPath(schoolId, branchId, assignmentId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/teacherAssignments/$(assignmentId);
    }

    function slotPath(schoolId, branchId, slotKey) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/assignmentSlots/$(slotKey);
    }

    // The uniqueness key of an assignment (see TeacherAssignment.slotKeyFor):
    // year__class__section__subjectId, or ...__CLASS_TEACHER.
    function slotKeyOf(data) {
      return data.academicYearId + '__' + data.classId + '__' + data.sectionId + '__'
        + (data.isClassTeacher == true ? 'CLASS_TEACHER' : data.subjectId);
    }

    // A staff member can never leave these statuses (StaffStatus.terminal).
    function isTerminalStaffStatus(status) {
      return status in ['RESIGNED', 'TERMINATED', 'RETIRED'];
    }

    function isActiveConfigEntry(path) {
      return get(path).data.status == 'ACTIVE';
    }

    function validConfigCode(data, id) {
      return data.code is string
        && data.code.matches('^[A-Za-z0-9_-]{2,20}$')
        && data.code.lower() == id;
    }

    // True for the caller's OWN staff record — found through the staff
    // document's userId link, not through the designation or any
    // client-supplied field.
    function isOwnStaffRecord(schoolId, branchId, staffData) {
      return callerWorksInBranch(schoolId, branchId)
        && staffData.userId != null && staffData.userId == request.auth.uid;
    }

    // ---- Attendance (Milestone 5) --------------------------------------
    //
    // Student attendance: managers (school/branch/platform admins) for their
    // scope, and the CLASS TEACHER of exactly that section (found through the
    // active CLASS_TEACHER assignment slot from Milestone 4 — a TEACHER role
    // alone grants nothing). Staff attendance: managers only; finance may
    // read. Parents: nothing.
    //
    // What rules cannot do here, and the client therefore does (documented in
    // docs/milestone-5-attendance-management.md): check that each student
    // really is enrolled in the section on that date (that is one document
    // read per student, far over the per-request limit), apply the working-
    // day/holiday calendar, and compute the day counts.
    function canManageAttendance(schoolId, branchId) {
      return canManageStaff(schoolId, branchId);
    }

    function classTeacherSlotPath(schoolId, branchId, academicYearId, classId, sectionId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /assignmentSlots/$(academicYearId + '__' + classId + '__' + sectionId + '__CLASS_TEACHER');
    }

    function isClassTeacherOf(schoolId, branchId, academicYearId, classId, sectionId) {
      return callerIsInBranchAs(schoolId, branchId, 'TEACHER')
        && exists(classTeacherSlotPath(schoolId, branchId, academicYearId, classId, sectionId))
        && get(staffPath(schoolId, branchId,
             get(classTeacherSlotPath(schoolId, branchId, academicYearId, classId, sectionId)).data.teacherStaffId)).data.userId == request.auth.uid
        && get(staffPath(schoolId, branchId,
             get(classTeacherSlotPath(schoolId, branchId, academicYearId, classId, sectionId)).data.teacherStaffId)).data.status == 'ACTIVE';
    }

    function canMarkStudentAttendance(schoolId, branchId, data) {
      return canManageAttendance(schoolId, branchId)
        || isClassTeacherOf(schoolId, branchId, data.academicYearId, data.classId, data.sectionId);
    }

    function attendanceSessionKey(data) {
      return data.dateKey + '__' + data.academicYearId + '__' + data.classId + '__' + data.sectionId;
    }

    function attendanceSessionPath(schoolId, branchId, sessionId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/attendanceSessions/$(sessionId);
    }

    function staffAttendanceDayPath(schoolId, branchId, dateKey) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/staffAttendanceDays/$(dateKey);
    }

    function isFinalizedDay(path) {
      return exists(path) && get(path).data.status == 'FINALIZED';
    }

    function validAttendanceStatus(status) {
      return status in ['PRESENT', 'ABSENT', 'LATE', 'HALF_DAY'];
    }

    function validDateKey(dateKey) {
      return dateKey is string && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Attendance cannot be recorded for a date later than tomorrow (one day
    // of slack for timezones). Past dates are allowed — that is what a late
    // entry or a correction is.
    function notFutureAttendance(data) {
      return data.attendanceDate is timestamp && data.attendanceDate <= request.time + duration.value(1, 'd');
    }

    function validRemarks(data) {
      return data.remarks == null || (data.remarks is string && data.remarks.size() <= 200);
    }

    function validChangeReason(data) {
      return data.lastChangeReason is string && data.lastChangeReason.size() > 0 && data.lastChangeReason.size() <= 300;
    }

    function validDayCounts(data) {
      return data.enrolled is int && data.present is int && data.absent is int && data.late is int
        && data.halfDay is int && data.notMarked is int
        && data.enrolled >= 0 && data.present >= 0 && data.absent >= 0 && data.late >= 0
        && data.halfDay >= 0 && data.notMarked >= 0;
    }

    function validDayFinalization(data) {
      return data.status == 'DRAFT'
        || (data.status == 'FINALIZED' && data.finalizedBy == request.auth.uid && data.finalizedAt == request.time);
    }

    // ---- Fees (Milestone 6) --------------------------------------------
    //
    // All money is an INTEGER in minor units, so these rules can check the
    // arithmetic. Roles (mirrors core/permissions):
    //   canFeeAdmin  — school/branch/platform admins: fee structures,
    //                  concessions, waivers, voiding, payment reversal/refund;
    //   canFeeStaff  — the above + FINANCE of the branch: assign fees, issue
    //                  invoices, collect payments, read everything;
    //   a PARENT may READ records of a child they are linked to
    //   (canAccessAsParent) and nothing else; teachers: nothing.
    //
    // WHAT THIS CAN AND CANNOT GUARANTEE. Rules see the state at commit time,
    // so two concurrent payments cannot both pass (the second sees the first's
    // balance and fails). Payments cannot exceed the balance, balances always
    // equal payable - waived - paid, ids make duplicates impossible, and
    // numbers are unique. They cannot verify that an invoice's line list sums
    // to its subtotal or matches the fee structures (a list cannot be summed
    // in rules), so a user holding the issue-invoice permission could
    // misprice an invoice. A trusted backend (Cloud Function) is the fix; this
    // project has none — see docs/milestone-6-fees-management.md.
    function canFeeAdmin(schoolId, branchId) {
      return canManageStaff(schoolId, branchId);
    }

    function canFeeStaff(schoolId, branchId) {
      return staffScope(schoolId, branchId, ['BRANCH_ADMIN', 'FINANCE']);
    }

    function feeDoc(schoolId, branchId, collection, id) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/$(collection)/$(id);
    }

    function isMinor(value) {
      return value is int && value >= 0 && value <= 1000000000000;
    }

    function isPositiveMinor(value) {
      return value is int && value > 0 && value <= 1000000000000;
    }

    function counterLast(path) {
      return exists(path) ? get(path).data.last : 0;
    }

    function invoiceStatusFor(payable, waived, paid) {
      return payable - waived - paid <= 0 ? 'PAID' : ((paid + waived) > 0 ? 'PARTIALLY_PAID' : 'ISSUED');
    }

    function validFeeReason(value) {
      return value is string && value.size() >= 3 && value.size() <= 300;
    }

    // ---- Leave (Milestone 7) -------------------------------------------
    //
    // Reviewers are the admins (canManageStaff). An application is PRIVATE
    // (reason, attachments, decision): its applicant, a parent linked to the
    // student, and reviewers read it. Teachers read only the minimal
    // leaveCalendar entry. Every status change must arrive together with its
    // append-only history record (existsAfter/getAfter), applicants cannot
    // touch decision fields, reviewers cannot decide their own application,
    // and a balance moves only with its ledger entry. Rules evaluate at
    // commit, so two concurrent decisions on one application cannot both pass
    // the "from PENDING" check.
    //
    // What rules cannot do: confirm countedDateKeys against the school
    // calendar, and check monthly accrual-to-date. The year-entitlement
    // ceiling IS enforced. See docs/milestone-7-leave-management.md.
    function canReviewLeave(schoolId, branchId) {
      return canManageStaff(schoolId, branchId);
    }

    function leaveDoc(schoolId, branchId, collection, id) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/$(collection)/$(id);
    }

    function leaveAdminOnBehalfAllowed(schoolId, branchId) {
      return exists(leaveDoc(schoolId, branchId, 'leaveSettings', 'policy'))
        && get(leaveDoc(schoolId, branchId, 'leaveSettings', 'policy')).data.allowAdminOnBehalf == true;
    }

    function isOwnLeaveStaff(schoolId, branchId, staffId) {
      return callerWorksInBranch(schoolId, branchId)
        && exists(staffPath(schoolId, branchId, staffId))
        && get(staffPath(schoolId, branchId, staffId)).data.userId == request.auth.uid
        && get(staffPath(schoolId, branchId, staffId)).data.status == 'ACTIVE';
    }

    // The user account behind a STAFF subject (null if none).
    function leaveStaffUserId(schoolId, branchId, staffId) {
      return get(staffPath(schoolId, branchId, staffId)).data.userId;
    }

    function validLeaveReason(data) {
      return !('reason' in data) || data.reason == null
        || (data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 500);
    }

    // The content of an application (create and resubmit): dates, units,
    // type policy, attachments and balance. Identity/relationship checks are
    // separate, in the create rule.
    function validLeaveBody(schoolId, branchId, data) {
      let typePath = leaveDoc(schoolId, branchId, 'leaveTypes', data.typeId);
      let type = get(typePath).data;
      let yearOk = data.academicYearId is string;
      return data.schoolId == schoolId && data.branchId == branchId
        && data.subjectKind in ['STUDENT', 'STAFF']
        && exists(typePath)
        && type.kind == data.subjectKind
        && type.status == 'ACTIVE'
        && data.typeName == type.name
        && data.payType == type.payType
        && validDateKey(data.startDateKey) && validDateKey(data.endDateKey)
        && data.endDateKey >= data.startDateKey
        && data.countedDateKeys is list
        && data.countedDateKeys.size() >= 1 && data.countedDateKeys.size() <= 60
        && data.countedDateKeys[0] >= data.startDateKey
        && data.countedDateKeys[data.countedDateKeys.size() - 1] <= data.endDateKey
        && data.halfDay in ['NONE', 'FIRST', 'SECOND']
        && data.units is int
        && (data.halfDay == 'NONE'
          ? data.units == data.countedDateKeys.size() * 2
          : (data.units == 1 && data.startDateKey == data.endDateKey && type.allowHalfDay == true))
        && data.countedDateKeys.size() <= (type.maxDaysPerRequest == null ? 60 : type.maxDaysPerRequest)
        && validLeaveReason(data)
        && (type.requiresReason != true || (data.reason is string && data.reason.size() >= 3))
        && data.attachments is list && data.attachments.size() <= 3
        && (type.requiresDocument != true || data.attachments.size() >= 1)
        && yearOk
        && validLeaveBalanceCeiling(schoolId, branchId, data, type);
    }

    // Staff, tracked type, BLOCK policy: the request may not exceed what the
    // whole year can ever allow (entitlement + carry-forward + adjustments -
    // consumed). Accrual-to-date (monthly) is checked by the client/reviewer.
    function validLeaveBalanceCeiling(schoolId, branchId, data, type) {
      let tracked = data.subjectKind == 'STAFF' && type.annualEntitlementUnits != null && type.payType == 'PAID';
      let balancePath = leaveDoc(schoolId, branchId, 'leaveBalances',
        data.subjectId + '__' + data.typeId + '__' + data.academicYearId);
      return !tracked
        || (data.balanceId == data.subjectId + '__' + data.typeId + '__' + data.academicYearId
          && (exists(balancePath)
            ? (get(balancePath).data.exceedPolicy == 'WARN'
              || data.units <= get(balancePath).data.entitlementUnits + get(balancePath).data.carryForwardUnits
                + get(balancePath).data.adjustmentUnits - get(balancePath).data.consumedUnits)
            : (type.exceedPolicy == 'WARN' || data.units <= type.annualEntitlementUnits)));
    }

    // The history record that accompanies an application change.
    function leaveHistoryAfter(schoolId, branchId, applicationId, revision) {
      return getAfter(leaveDoc(schoolId, branchId, 'leaveHistory', applicationId + '__' + string(revision))).data;
    }

    function leaveHistoryMatches(schoolId, branchId, applicationId, revision, fromStatus, toStatus, event) {
      return existsAfter(leaveDoc(schoolId, branchId, 'leaveHistory', applicationId + '__' + string(revision)))
        && leaveHistoryAfter(schoolId, branchId, applicationId, revision).fromStatus == fromStatus
        && leaveHistoryAfter(schoolId, branchId, applicationId, revision).toStatus == toStatus
        && leaveHistoryAfter(schoolId, branchId, applicationId, revision).event == event
        && leaveHistoryAfter(schoolId, branchId, applicationId, revision).actorId == request.auth.uid;
    }

    // ---- Timetable & substitution (Milestone 8) -------------------------
    //
    // Managers are the admins (canManageStaff). Timetable versions move
    // DRAFT -> PUBLISHED -> ARCHIVED; every change carries its append-only
    // history record, and anything that changes what is *published* (publish,
    // supersede, truncate, withdraw) must also bump the branch publication
    // lock in the same commit — so a validation done against an older
    // published set cannot be committed after a newer publish.
    //
    // What rules cannot do: query the other published timetables, so "no
    // teacher is double-booked" is verified by the client under that lock
    // (TimetableValidator), not by rules. Rules do enforce: the state machine,
    // the lock, that an entry's teacher really holds the section's ACTIVE
    // assignment for the subject (assignmentSlots), that entries only change
    // while their timetable is a DRAFT, and that a substitution is for a live
    // entry of a published timetable, by an ACTIVE teacher other than the
    // original. See docs/milestone-8-timetable-substitution.md.
    function ttDoc(schoolId, branchId, collection, id) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)/$(collection)/$(id);
    }

    function canManageTimetable(schoolId, branchId) {
      return canManageStaff(schoolId, branchId);
    }

    // ---- Family (parent) read scope — Milestone 12A (F-SEC-3) ----------
    // A parent may read class-specific content (homework, schedules,
    // examinations) only for a class/section where THEY have a linked,
    // portal-enabled, active child. Rules cannot enumerate a parent's
    // children, so staff who change a link or a placement also refresh a small
    // per-branch index, `parentAccess/{parentId}` (classKeys `classId`,
    // sectionKeys `classId__sectionId`); see docs/milestone-12a-….
    // A missing index document grants nothing (fail closed).
    function isFamilyCaller(schoolId) {
      return isActiveCaller() && callerSchoolId() == schoolId && callerRole() == 'PARENT'
        && callerProfile().linkedParentId is string;
    }

    function parentAccessPath(schoolId, branchId) {
      return ttDoc(schoolId, branchId, 'parentAccess', callerProfile().linkedParentId);
    }

    // The family has a child in this branch at all.
    function parentInBranch(schoolId, branchId) {
      return isFamilyCaller(schoolId) && exists(parentAccessPath(schoolId, branchId));
    }

    function parentHasClass(schoolId, branchId, classId) {
      return isFamilyCaller(schoolId) && exists(parentAccessPath(schoolId, branchId))
        && classId in get(parentAccessPath(schoolId, branchId)).data.classKeys;
    }

    function parentHasSection(schoolId, branchId, classId, sectionId) {
      return isFamilyCaller(schoolId) && exists(parentAccessPath(schoolId, branchId))
        && (classId + '__' + sectionId) in get(parentAccessPath(schoolId, branchId)).data.sectionKeys;
    }

    // Which audiences of a notice/announcement a PARENT may read:
    //   ALL                  every active parent of the school;
    //   BRANCH, PARENTS      a family with a child in the branch (parentAccess);
    //   CLASS                only a family with a child in THAT class;
    //   SECTION              only a family with a child in THAT section;
    //   STAFF (anything else) never.
    // A query must therefore name the audience (and class/section) it asks for.
    function parentMayReadAudience(schoolId, branchId, d) {
      return d.audienceKind == 'ALL'
        || (d.audienceKind in ['BRANCH', 'PARENTS'] && parentInBranch(schoolId, branchId))
        || (d.audienceKind == 'CLASS' && parentHasClass(schoolId, branchId, d.get('classId', null)))
        || (d.audienceKind == 'SECTION'
            && parentHasSection(schoolId, branchId, d.get('classId', null), d.get('sectionId', null)));
    }

    // A published/live schedule-or-homework document of one section: teachers
    // of the branch, and parents with a child in that exact section.
    function canReadSectionContent(schoolId, branchId, d) {
      return callerIsInBranchAs(schoolId, branchId, 'TEACHER')
        || parentHasSection(schoolId, branchId, d.classId, d.sectionId);
    }

    // The publication lock moves by exactly one in this commit.
    function publishLockBumped(schoolId, branchId) {
      return existsAfter(ttDoc(schoolId, branchId, 'timetableLocks', 'branch'))
        && (exists(ttDoc(schoolId, branchId, 'timetableLocks', 'branch'))
          ? getAfter(ttDoc(schoolId, branchId, 'timetableLocks', 'branch')).data.publishSeq
              == get(ttDoc(schoolId, branchId, 'timetableLocks', 'branch')).data.publishSeq + 1
          : getAfter(ttDoc(schoolId, branchId, 'timetableLocks', 'branch')).data.publishSeq == 1);
    }

    function timetableHistoryOk(schoolId, branchId, timetableId, data) {
      return existsAfter(ttDoc(schoolId, branchId, 'timetableHistory', timetableId + '__' + string(data.revision)))
        && getAfter(ttDoc(schoolId, branchId, 'timetableHistory', timetableId + '__' + string(data.revision))).data.event
             == data.lastEvent
        && getAfter(ttDoc(schoolId, branchId, 'timetableHistory', timetableId + '__' + string(data.revision))).data.actorId
             == request.auth.uid;
    }

    function validEffectiveRange(data) {
      return validDateKey(data.effectiveFromKey)
        && (data.effectiveToKey == null
          || (validDateKey(data.effectiveToKey) && data.effectiveToKey >= data.effectiveFromKey));
    }

    function substitutionDayBumped(schoolId, branchId, dateKey) {
      return existsAfter(ttDoc(schoolId, branchId, 'substitutionDays', dateKey))
        && (exists(ttDoc(schoolId, branchId, 'substitutionDays', dateKey))
          ? getAfter(ttDoc(schoolId, branchId, 'substitutionDays', dateKey)).data.seq
              == get(ttDoc(schoolId, branchId, 'substitutionDays', dateKey)).data.seq + 1
          : getAfter(ttDoc(schoolId, branchId, 'substitutionDays', dateKey)).data.seq == 1);
    }

    function substitutionHistoryOk(schoolId, branchId, id, data) {
      return existsAfter(ttDoc(schoolId, branchId, 'substitutionHistory', id + '__' + string(data.revision)))
        && getAfter(ttDoc(schoolId, branchId, 'substitutionHistory', id + '__' + string(data.revision))).data.event
             == data.lastEvent
        && getAfter(ttDoc(schoolId, branchId, 'substitutionHistory', id + '__' + string(data.revision))).data.actorId
             == request.auth.uid;
    }

    function validSubstituteTeacher(schoolId, branchId, data) {
      return data.substituteTeacherId != data.originalTeacherId
        && get(staffPath(schoolId, branchId, data.substituteTeacherId)).data.status == 'ACTIVE'
        && get(staffPath(schoolId, branchId, data.substituteTeacherId)).data.isTeacher == true
        && validFeeReason(data.reason);
    }

    // The slot of the timetable's section that this entry occupies is covered
    // by the entry's own teacher (the ACTIVE assignment for the subject).
    function entryTeacherAssigned(schoolId, branchId, data) {
      return get(slotPath(schoolId, branchId,
          data.academicYearId + '__' + data.classId + '__' + data.sectionId + '__' + data.subjectId))
        .data.teacherStaffId == data.teacherStaffId;
    }

    function validEntryBody(schoolId, branchId, timetableId, data) {
      // getAfter: the timetable may be created in the same commit as its cells
      let tt = getAfter(ttDoc(schoolId, branchId, 'timetables', timetableId)).data;
      return data.schoolId == schoolId && data.branchId == branchId
        && data.timetableId == timetableId
        && tt.status == 'DRAFT'
        && data.academicYearId == tt.academicYearId
        && data.classId == tt.classId
        && data.sectionId == tt.sectionId
        && data.weekday in ['MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY', 'SUNDAY']
        && data.slotId is string && data.slotId.matches('^[a-z0-9_]{1,12}$')
        && data.periodNumber is int && data.periodNumber >= 1
        && data.startMin is int && data.endMin is int
        && data.startMin >= 0 && data.endMin <= 1440 && data.startMin < data.endMin
        && data.subjectId is string && data.teacherStaffId is string
        && data.live == false
        && (data.room == null || (data.room is string && data.room.size() <= 40))
        && tt.dayPeriodSets.keys().hasAny([data.weekday])
        && entryTeacherAssigned(schoolId, branchId, data);
    }

    // ---- Homework, submissions, announcements (Milestone 9) -------------
    //
    // Authorisation comes from relationships the system already holds:
    //  * a teacher may author/publish homework only for a section+subject
    //    whose ACTIVE assignment slot names them (M4 assignmentSlots) — the
    //    client-sent teacher id is checked against that slot, not trusted;
    //  * a parent may submit only for a LINKED child (ACTIVE portal link) who
    //    is currently placed in the homework's class and section;
    //  * lateness is decided against the SERVER clock (`request.time`) and the
    //    homework's stored deadline, never a client-claimed time;
    //  * grades are bounded by the homework's maximum and only the homework's
    //    teacher (or an admin) may write them; students cannot touch them.
    // What rules cannot do: tie a parent to a section for READING published
    // homework/announcements/notices (that needs a lookup by child), or hide a
    // scheduled announcement before its publish time. See
    // docs/milestone-9-homework-assignments-announcements.md §10.
    function profileOwnsStaff(p, schoolId, branchId, staffId) {
      let path = staffPath(schoolId, branchId, staffId);
      return p.status == 'ACTIVE' && p.schoolId == schoolId && branchRoleOf(p, branchId) != null
        && exists(path)
        && get(path).data.userId == request.auth.uid
        && get(path).data.status == 'ACTIVE';
    }

    function profileTeachesHomework(p, schoolId, branchId, staffId) {
      return profileManages(p, schoolId, branchId)
        || profileOwnsStaff(p, schoolId, branchId, staffId);
    }

    function profileIsLinkedParent(p, schoolId, branchId, studentId) {
      let link = parentLinkPath(schoolId, branchId, studentId, p.linkedParentId);
      return p.status == 'ACTIVE' && p.role == 'PARENT' && p.schoolId == schoolId
        && p.linkedParentId != null
        && exists(link)
        && get(link).data.canAccessPortal == true
        && get(link).data.status == 'ACTIVE';
    }

    // The targeted homework notice agrees with the submission change in the
    // same commit: its revision, its recipient (who submitted), its writer
    // and the event it announces.
    function homeworkNotificationOk(schoolId, branchId, id, n) {
      let path = ttDoc(schoolId, branchId, 'homeworkSubmissions', n.submissionId);
      return n.submissionId is string
        && existsAfter(path)
        && getAfter(path).data.revision == n.revision
        && n.recipientUserId == getAfter(path).data.submittedBy
        && getAfter(path).data.updatedBy == request.auth.uid
        && {'RETURN': 'HOMEWORK_RETURNED', 'GRADE': 'HOMEWORK_GRADED'}[getAfter(path).data.lastEvent] == n.type;
    }

    // The slot of this section+subject names the claimed teacher.
    function homeworkSlotNamesTeacher(schoolId, branchId, data) {
      let slot = slotPath(schoolId, branchId,
        data.academicYearId + '__' + data.classId + '__' + data.sectionId + '__' + data.subjectId);
      return exists(slot) && get(slot).data.teacherStaffId == data.teacherStaffId;
    }

    function homeworkSlotTeacherOk(schoolId, branchId, data) {
      return homeworkSlotNamesTeacher(schoolId, branchId, data)
        && profileTeachesHomework(callerProfile(), schoolId, branchId, data.teacherStaffId);
    }

    // The change's append-only record exists in this commit and agrees.
    function homeworkHistoryOk(schoolId, branchId, id, data) {
      let path = ttDoc(schoolId, branchId, 'homeworkHistory', id + '__' + string(data.revision));
      return existsAfter(path)
        && getAfter(path).data.event == data.lastEvent
        && getAfter(path).data.toStatus == data.status
        && getAfter(path).data.actorId == request.auth.uid;
    }

    function homeworkNoticeOk(schoolId, branchId, id, data, event) {
      let path = ttDoc(schoolId, branchId, 'broadcastNotices', id + '__' + event + '__' + string(data.revision));
      return existsAfter(path) && getAfter(path).data.refId == id;
    }

    function validHomeworkBody(data) {
      return data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 4000
        && validDateKey(data.dueDateKey) && validDateKey(data.assignedDateKey)
        && data.dueDateKey >= data.assignedDateKey
        && data.dueAt is timestamp
        && (data.dueTimeMin == null || (data.dueTimeMin is int && data.dueTimeMin >= 0 && data.dueTimeMin < 1440))
        && (data.maxMarks == null || (data.maxMarks is int && data.maxMarks >= 1 && data.maxMarks <= 1000))
        && data.attachments is list && data.attachments.size() <= 5
        && data.requiresSubmission is bool && data.allowFiles is bool
        && data.allowLate is bool && data.allowResubmission is bool;
    }

    function validSubmissionContent(hw, data) {
      return data.attachments is list && data.attachments.size() <= 3
        && (data.attachments.size() == 0 || hw.allowFiles == true)
        && data.textAnswer is string && data.textAnswer.size() <= 5000
        && (data.textAnswer.size() > 0 || data.attachments.size() > 0);
    }

    function submissionRevisionOk(schoolId, branchId, id, data) {
      let path = ttDoc(schoolId, branchId, 'homeworkRevisions', id + '__' + string(data.revision));
      return existsAfter(path)
        && getAfter(path).data.event == data.lastEvent
        && getAfter(path).data.status == data.status
        && getAfter(path).data.actorId == request.auth.uid;
    }

    // A parent's FIRST submission for a linked, correctly placed child.
    function submissionCreateOk(schoolId, branchId, id, data) {
      let hw = get(ttDoc(schoolId, branchId, 'homework', data.homeworkId)).data;
      let student = get(ttDoc(schoolId, branchId, 'students', data.studentId)).data;
      return id == data.homeworkId + '__' + data.studentId
        && profileIsLinkedParent(callerProfile(), schoolId, branchId, data.studentId)
        && hw.status == 'PUBLISHED' && hw.requiresSubmission == true
        && data.academicYearId == hw.academicYearId
        && data.classId == hw.classId && data.sectionId == hw.sectionId
        && student.status == 'ACTIVE'
        && student.currentClassId == hw.classId && student.currentSectionId == hw.sectionId
        && data.submittedBy == request.auth.uid
        && data.submittedAt == request.time && data.createdAt == request.time && data.updatedAt == request.time
        && data.createdBy == request.auth.uid && data.updatedBy == request.auth.uid
        && data.revision == 1 && data.lastEvent == 'SUBMIT'
        && (request.time <= hw.dueAt
            ? (data.status == 'SUBMITTED' && data.late == false)
            : (hw.allowLate == true && data.status == 'LATE_SUBMITTED' && data.late == true))
        && validSubmissionContent(hw, data)
        && data.feedback == null && data.marks == null && data.gradedBy == null && data.reviewedBy == null;
    }

    // The family changing the work (never marks or feedback).
    function familyChangeOk(schoolId, branchId, before, after) {
      let hw = get(ttDoc(schoolId, branchId, 'homework', before.homeworkId)).data;
      let student = get(ttDoc(schoolId, branchId, 'students', before.studentId)).data;
      return profileIsLinkedParent(callerProfile(), schoolId, branchId, before.studentId)
        && hw.status == 'PUBLISHED'
        // a child who has moved sections or left can no longer change work
        // set for the section they were in (history stays readable)
        && student.status == 'ACTIVE'
        && student.currentClassId == hw.classId
        && student.currentSectionId == hw.sectionId
        && before.status in ['SUBMITTED', 'LATE_SUBMITTED', 'RESUBMITTED', 'RETURNED_FOR_REVISION']
        && after.status == 'RESUBMITTED' && after.lastEvent == 'RESUBMIT'
        && (before.status == 'RETURNED_FOR_REVISION'
            || (hw.allowResubmission == true && (request.time <= hw.dueAt || hw.allowLate == true)))
        && after.late == (before.late == true || request.time > hw.dueAt)
        && after.submittedBy == request.auth.uid && after.submittedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['status', 'late', 'textAnswer', 'attachments',
             'revision', 'lastEvent', 'submittedBy', 'submittedAt', 'updatedAt', 'updatedBy'])
        && validSubmissionContent(hw, after);
    }

    // The homework's teacher (or an admin) grades, returns or reviews.
    function reviewerChangeOk(schoolId, branchId, before, after) {
      let hw = get(ttDoc(schoolId, branchId, 'homework', before.homeworkId)).data;
      let keys = after.diff(before).affectedKeys();
      return profileTeachesHomework(callerProfile(), schoolId, branchId, hw.teacherStaffId)
        && hw.status in ['PUBLISHED', 'CLOSED']
        && (
          // grade: marks within the homework's maximum
          (before.status in ['SUBMITTED', 'LATE_SUBMITTED', 'RESUBMITTED', 'GRADED']
            && after.status == 'GRADED' && after.lastEvent == 'GRADE'
            && after.gradedBy == request.auth.uid && after.gradedAt == request.time
            && (hw.maxMarks == null
                ? after.marks == null
                : (after.marks is int && after.marks >= 0 && after.marks <= hw.maxMarks))
            && (after.feedback == null || (after.feedback is string && after.feedback.size() <= 2000))
            && keys.hasOnly(['status', 'marks', 'feedback', 'gradedBy', 'gradedByName', 'gradedAt',
                             'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
          ||
          // return for revision, with a reason
          (before.status in ['SUBMITTED', 'LATE_SUBMITTED', 'RESUBMITTED', 'GRADED']
            && after.status == 'RETURNED_FOR_REVISION' && after.lastEvent == 'RETURN'
            && after.feedback is string && after.feedback.size() >= 3
            && after.marks == null && after.gradedBy == null
            && after.reviewedBy == request.auth.uid && after.reviewedAt == request.time
            && keys.hasOnly(['status', 'marks', 'feedback', 'gradedBy', 'gradedByName', 'gradedAt',
                             'reviewedBy', 'reviewedAt', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
          ||
          // mark as reviewed (no change of state)
          (before.status in ['SUBMITTED', 'LATE_SUBMITTED', 'RESUBMITTED']
            && after.status == before.status && after.lastEvent == 'REVIEW'
            && after.reviewedBy == request.auth.uid && after.reviewedAt == request.time
            && keys.hasOnly(['reviewedBy', 'reviewedAt', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
        );
    }

    function announcementHistoryOk(schoolId, branchId, id, data) {
      let path = ttDoc(schoolId, branchId, 'announcementHistory', id + '__' + string(data.revision));
      return existsAfter(path)
        && getAfter(path).data.event == data.lastEvent
        && getAfter(path).data.actorId == request.auth.uid;
    }

    // Immutable fields (tenant, audience, author, creation audit) are
    // protected by every branch's changedOnly list: anything not named there
    // cannot change.
    function announcementUpdateOk(schoolId, branchId, id, before, after) {
      let p = callerProfile();
      let diff = after.diff(before).affectedKeys();
      return (profileManages(p, schoolId, branchId)
              || (p.status == 'ACTIVE' && before.authorId == request.auth.uid))
        && after.updatedAt == request.time
        && after.updatedBy == request.auth.uid
        && after.revision == before.revision + 1
        && announcementHistoryOk(schoolId, branchId, id, after)
        && (
          // edit a draft
          (before.status == 'DRAFT' && after.status == 'DRAFT' && after.lastEvent == 'EDITED'
            && diff.hasOnly(['title', 'body', 'attachments', 'publishAt', 'expiresAt', 'revision',
                             'lastEvent', 'updatedAt', 'updatedBy']))
          ||
          // publish: still addressed within the author's authority, the
          // notice is written with it, and a stored expiry follows the start
          (before.status == 'DRAFT' && after.status == 'PUBLISHED' && after.lastEvent == 'PUBLISHED'
            && after.publishedBy == request.auth.uid
            && after.publishedAt == request.time
            && after.publishAt is timestamp
            && (after.expiresAt == null
                || (after.expiresAt is timestamp && after.expiresAt > after.publishAt))
            && diff.hasOnly(['status', 'publishAt', 'expiresAt', 'publishedBy', 'publishedAt', 'revision',
                             'lastEvent', 'updatedAt', 'updatedBy'])
            && profileMayAddress(p, schoolId, branchId, before)
            && homeworkNoticeOk(schoolId, branchId, id, after, 'PUBLISHED'))
          ||
          // change a published announcement's text / materials / expiry
          (before.status == 'PUBLISHED' && after.status == 'PUBLISHED' && after.lastEvent == 'UPDATED'
            && diff.hasOnly(['title', 'body', 'attachments', 'expiresAt', 'revision', 'lastEvent',
                             'updatedAt', 'updatedBy'])
            && after.title is string && after.title.size() >= 3
            && after.body is string && after.body.size() >= 1)
          ||
          // archive keeps the record
          (before.status in ['DRAFT', 'PUBLISHED'] && after.status == 'ARCHIVED'
            && after.lastEvent == 'ARCHIVED'
            && diff.hasOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
        );
    }

    // Who may address this audience: school admins (anyone), branch admins
    // (their branch, never the whole school), and a teacher only to a SECTION
    // of which they are the class teacher. Written against one profile read
    // (`p`) so the announcement rules stay inside the evaluation budget.
    function profileManages(p, schoolId, branchId) {
      return p.status == 'ACTIVE'
        && (p.role == 'PLATFORM_ADMIN'
            || (p.schoolId == schoolId
                && (p.role == 'SCHOOL_ADMIN'
                    || branchRoleOf(p, branchId) == 'BRANCH_ADMIN')));
    }

    function profileIsClassTeacher(p, schoolId, branchId, data) {
      let slot = classTeacherSlotPath(
        schoolId, branchId, data.academicYearId, data.classId, data.sectionId);
      return p.status == 'ACTIVE' && p.schoolId == schoolId
        && branchRoleOf(p, branchId) == 'TEACHER'
        && exists(slot)
        && get(staffPath(schoolId, branchId, get(slot).data.teacherStaffId)).data.userId == request.auth.uid
        && get(staffPath(schoolId, branchId, get(slot).data.teacherStaffId)).data.status == 'ACTIVE';
    }

    function profileMayAddress(p, schoolId, branchId, data) {
      return (data.audienceKind == 'ALL'
          ? (p.status == 'ACTIVE'
              && (p.role == 'PLATFORM_ADMIN' || (p.role == 'SCHOOL_ADMIN' && p.schoolId == schoolId)))
          : profileManages(p, schoolId, branchId))
        || (data.audienceKind == 'SECTION' && profileIsClassTeacher(p, schoolId, branchId, data));
    }

    function canAddressAudience(schoolId, branchId, data) {
      return profileMayAddress(callerProfile(), schoolId, branchId, data);
    }

    function isAnnouncementAuthorOrManager(schoolId, branchId, authorId) {
      let p = callerProfile();
      return profileManages(p, schoolId, branchId)
        || (p.status == 'ACTIVE' && authorId == request.auth.uid);
    }

    // ---- Examinations, marks and results (Milestone 10) ----------------
    //
    // Authority comes from what the system already holds: administrators
    // configure, review, finalise and publish; a teacher enters marks only
    // for a section+subject whose ACTIVE assignment slot names them; a parent
    // reads a result only through an ACTIVE, portal-enabled link, only while
    // the examination is PUBLISHED, and only the version in force. Finalised
    // results are create-only and versioned: a correction is a withdrawal,
    // the marks workflow again, and a NEW version. Arithmetic (totals,
    // grades) cannot be recomputed in rules; it is done by one calculator and
    // stored with the scheme snapshot (see docs/milestone-10-…md §9).
    function examHistoryOk(schoolId, branchId, id, data) {
      let path = ttDoc(schoolId, branchId, 'examHistory', id + '__' + string(data.revision));
      return existsAfter(path)
        && getAfter(path).data.event == data.lastEvent
        && getAfter(path).data.toStatus == data.status
        && getAfter(path).data.actorId == request.auth.uid;
    }

    function examNoteOk(schoolId, branchId, id, data) {
      let path = ttDoc(schoolId, branchId, 'examHistory', id + '__' + string(data.revision));
      return getAfter(path).data.note is string && getAfter(path).data.note.size() >= 3;
    }

    function validExamBody(d) {
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 80
        && d.description is string && d.description.size() <= 500
        && d.type in ['UNIT_TEST', 'QUARTERLY', 'HALF_YEARLY', 'ANNUAL', 'PRACTICAL', 'OTHER']
        && d.schemeId is string && d.schemeId.size() > 0
        && validDateKey(d.startDateKey) && validDateKey(d.endDateKey)
        && d.endDateKey >= d.startDateKey
        && d.instructions is string && d.instructions.size() <= 2000;
    }

    function validSubjectConfig(d) {
      return d.maxMarks is number && d.maxMarks > 0 && d.maxMarks <= 1000
        && (d.passMarks == null || (d.passMarks is number && d.passMarks >= 0 && d.passMarks <= d.maxMarks))
        && d.weightage is number && d.weightage > 0 && d.weightage <= 100
        && ((d.theoryMax == null && d.practicalMax == null)
            || (d.theoryMax is number && d.practicalMax is number
                && d.theoryMax >= 0 && d.practicalMax >= 0
                && d.theoryMax + d.practicalMax == d.maxMarks))
        && (d.dateKey == null || validDateKey(d.dateKey))
        && ((d.startMin == null && d.endMin == null)
            || (d.startMin is int && d.endMin is int && d.startMin >= 0
                && d.endMin <= 1440 && d.endMin > d.startMin));
    }

    // The writer may enter/submit marks for this section+subject: an admin,
    // or the staff member the ACTIVE assignment slot names.
    function profileMayEnterMarks(p, schoolId, branchId, d) {
      let slot = slotPath(schoolId, branchId,
        d.academicYearId + '__' + d.classId + '__' + d.sectionId + '__' + d.subjectId);
      return profileManages(p, schoolId, branchId)
        || (branchRoleOf(p, branchId) == 'TEACHER' && exists(slot)
            && profileOwnsStaff(p, schoolId, branchId, get(slot).data.teacherStaffId));
    }

    function entryMarksOk(sub, d) {
      return d.remark is string && d.remark.size() <= 200
        && (d.status == 'ENTERED'
            ? (d.marks is number && d.marks >= 0 && d.marks <= sub.maxMarks
               && (sub.theoryMax == null
                   ? (d.theory == null && d.practical == null)
                   : (d.theory is number && d.practical is number
                      && d.theory >= 0 && d.theory <= sub.theoryMax
                      && d.practical >= 0 && d.practical <= sub.practicalMax
                      && d.marks == d.theory + d.practical)))
            : (d.status in ['ABSENT', 'EXEMPTED', 'PENDING']
               && d.marks == null && d.theory == null && d.practical == null));
    }

    function entryRevisionOk(schoolId, branchId, id, d) {
      let path = ttDoc(schoolId, branchId, 'marksRevisions', id + '__' + string(d.revision));
      return existsAfter(path)
        && getAfter(path).data.status == d.status
        && getAfter(path).data.actorId == request.auth.uid;
    }

    // One entry written (created or revised) by a person allowed to enter it,
    // for a student enrolled in that class+section, while the examination is
    // in marks entry and the sheet is editable. `d` is the entry as written.
    function entryContextOk(schoolId, branchId, d) {
      let exam = get(ttDoc(schoolId, branchId, 'examinations', d.examId)).data;
      let sheet = getAfter(ttDoc(schoolId, branchId, 'marksSheets', d.sheetId)).data;
      let student = get(ttDoc(schoolId, branchId, 'students', d.studentId)).data;
      let sub = get(ttDoc(schoolId, branchId, 'examinationSubjects', d.examId + '__' + d.subjectId)).data;
      return d.schoolId == schoolId && d.branchId == branchId
        && d.sheetId == d.examId + '__' + d.subjectId + '__' + d.sectionId
        && exam.status == 'IN_PROGRESS'
        && d.academicYearId == exam.academicYearId && d.classId == exam.classId
        && (exam.sectionId == null || exam.sectionId == d.sectionId)
        && sheet.status in ['DRAFT', 'RETURNED']
        && student.status == 'ACTIVE'
        && student.currentAcademicYearId == d.academicYearId
        && student.currentClassId == d.classId
        && student.currentSectionId == d.sectionId
        && entryMarksOk(sub, d)
        && profileMayEnterMarks(callerProfile(), schoolId, branchId, d);
    }

    function sheetHistoryOk(schoolId, branchId, id, data) {
      let path = ttDoc(schoolId, branchId, 'marksSheetHistory', id + '__' + string(data.revision));
      return existsAfter(path)
        && getAfter(path).data.event == data.lastEvent
        && getAfter(path).data.toStatus == data.status
        && getAfter(path).data.actorId == request.auth.uid;
    }

    // The examination's approved-sheet counter moves by `delta` in the same commit.
    function examApprovedMovesBy(schoolId, branchId, examId, delta) {
      let path = ttDoc(schoolId, branchId, 'examinations', examId);
      return getAfter(path).data.approvedSheets == get(path).data.approvedSheets + delta;
    }

    function sheetUpdateOk(schoolId, branchId, id, before, after) {
      let p = callerProfile();
      let exam = get(ttDoc(schoolId, branchId, 'examinations', before.examId)).data;
      let diff = after.diff(before).affectedKeys();
      return p.status == 'ACTIVE' && exam.status == 'IN_PROGRESS'
        && after.updatedAt == request.time && after.updatedBy == request.auth.uid
        && (
          // the roster size moves with saves (no state change)
          (before.status in ['DRAFT', 'RETURNED'] && after.status == before.status
            && after.revision == before.revision
            && diff.hasOnly(['rosterCount', 'updatedAt', 'updatedBy'])
            && after.rosterCount is int && after.rosterCount >= 0
            && profileMayEnterMarks(p, schoolId, branchId, before))
          ||
          // submit for review
          (before.status in ['DRAFT', 'RETURNED'] && after.status == 'SUBMITTED'
            && after.lastEvent == 'SUBMITTED' && after.revision == before.revision + 1
            && after.submittedBy == request.auth.uid && after.submittedAt == request.time
            && diff.hasOnly(['status', 'submittedBy', 'submittedAt', 'revision', 'lastEvent',
                             'updatedAt', 'updatedBy'])
            && sheetHistoryOk(schoolId, branchId, id, after)
            && profileMayEnterMarks(p, schoolId, branchId, before))
          ||
          // approve: an administrator; not the submitter unless school admin
          (before.status == 'SUBMITTED' && after.status == 'APPROVED'
            && after.lastEvent == 'APPROVED' && after.revision == before.revision + 1
            && after.approvedBy == request.auth.uid && after.approvedAt == request.time
            && (before.submittedBy != request.auth.uid
                || p.role in ['SCHOOL_ADMIN', 'PLATFORM_ADMIN'])
            && diff.hasOnly(['status', 'approvedBy', 'approvedAt', 'revision', 'lastEvent',
                             'updatedAt', 'updatedBy'])
            && profileManages(p, schoolId, branchId)
            && examApprovedMovesBy(schoolId, branchId, before.examId, 1)
            && sheetHistoryOk(schoolId, branchId, id, after))
          ||
          // return for correction (from review or from approved)
          (before.status in ['SUBMITTED', 'APPROVED'] && after.status == 'RETURNED'
            && after.lastEvent == 'RETURNED' && after.revision == before.revision + 1
            && after.reviewNote is string && after.reviewNote.size() >= 3
            && diff.hasOnly(['status', 'reviewNote', 'approvedBy', 'approvedAt', 'revision', 'lastEvent',
                             'updatedAt', 'updatedBy'])
            && profileManages(p, schoolId, branchId)
            && (before.status == 'SUBMITTED' || examApprovedMovesBy(schoolId, branchId, before.examId, -1))
            && sheetHistoryOk(schoolId, branchId, id, after))
        );
    }

    function examUpdateOk(schoolId, branchId, id, before, after) {
      let diff = after.diff(before).affectedKeys();
      return profileManages(callerProfile(), schoolId, branchId)
        && after.updatedAt == request.time && after.updatedBy == request.auth.uid
        && (
          // counters that move with other documents (no revision)
          (after.revision == before.revision && after.status == before.status
            && (
              (before.status in ['DRAFT', 'SCHEDULED']
                && diff.hasOnly(['subjectCount', 'updatedAt', 'updatedBy'])
                && after.subjectCount >= 0
                && (after.subjectCount == before.subjectCount + 1
                    || after.subjectCount == before.subjectCount - 1))
              ||
              (before.status == 'IN_PROGRESS'
                && diff.hasOnly(['approvedSheets', 'updatedAt', 'updatedBy'])
                && after.approvedSheets >= 0 && after.approvedSheets <= before.sheetCount
                && (after.approvedSheets == before.approvedSheets + 1
                    || after.approvedSheets == before.approvedSheets - 1))
              ||
              (before.status == 'COMPLETED'
                && diff.hasOnly(['resultsWritten', 'updatedAt', 'updatedBy'])
                && after.resultsWritten > before.resultsWritten
                && after.resultsWritten <= before.resultCount)
            ))
          ||
          // state and configuration changes: revision + 1 and a history record
          (after.revision == before.revision + 1 && examHistoryOk(schoolId, branchId, id, after)
            && (
              // edit configuration
              (before.status in ['DRAFT', 'SCHEDULED'] && after.status == before.status
                && after.lastEvent == 'EDITED' && validExamBody(after)
                && diff.hasOnly(['name', 'description', 'type', 'schemeId', 'startDateKey', 'endDateKey',
                                 'instructions', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              (before.status == 'DRAFT' && after.status == 'SCHEDULED' && after.lastEvent == 'SCHEDULED'
                && before.subjectCount >= 1
                && diff.hasOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              (before.status == 'SCHEDULED' && after.status == 'IN_PROGRESS' && after.lastEvent == 'STARTED'
                && after.sheetCount is int && after.sheetCount >= 1 && after.approvedSheets == 0
                && diff.hasOnly(['status', 'sheetCount', 'approvedSheets', 'revision', 'lastEvent',
                                 'updatedAt', 'updatedBy']))
              ||
              // finalise: every sheet approved; the next version; the scheme snapshot
              (before.status == 'IN_PROGRESS' && after.status == 'COMPLETED' && after.lastEvent == 'FINALIZED'
                && before.sheetCount >= 1 && before.approvedSheets == before.sheetCount
                && after.resultVersion == before.resultVersion + 1
                && after.resultCount is int && after.resultCount >= 1
                && after.resultsWritten == 0
                && after.schemeSnapshot is map
                && after.finalizedBy == request.auth.uid
                && diff.hasOnly(['status', 'resultVersion', 'resultCount', 'resultsWritten', 'schemeSnapshot',
                                 'finalizedBy', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              // publish: every result of this version written; notice with it
              (before.status == 'COMPLETED' && after.status == 'PUBLISHED' && after.lastEvent == 'PUBLISHED'
                && before.resultCount >= 1 && before.resultsWritten == before.resultCount
                && after.publishedBy == request.auth.uid && after.publishedAt == request.time
                && diff.hasOnly(['status', 'publishedBy', 'publishedAt', 'revision', 'lastEvent',
                                 'updatedAt', 'updatedBy'])
                && existsAfter(ttDoc(schoolId, branchId, 'broadcastNotices',
                     id + '__PUBLISHED__' + string(before.resultVersion))))
              ||
              (before.status == 'PUBLISHED' && after.status == 'WITHDRAWN' && after.lastEvent == 'WITHDRAWN'
                && diff.hasOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy'])
                && examNoteOk(schoolId, branchId, id, after))
              ||
              // reopen for correction: results of the old version stay as history
              (before.status in ['COMPLETED', 'WITHDRAWN'] && after.status == 'IN_PROGRESS'
                && after.lastEvent == 'REOPENED'
                && after.resultsWritten == 0 && after.resultCount == 0
                && diff.hasOnly(['status', 'resultsWritten', 'resultCount', 'revision', 'lastEvent',
                                 'updatedAt', 'updatedBy'])
                && examNoteOk(schoolId, branchId, id, after))
              ||
              (before.status in ['DRAFT', 'SCHEDULED', 'IN_PROGRESS'] && after.status == 'CANCELLED'
                && after.lastEvent == 'CANCELLED'
                && diff.hasOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy'])
                && examNoteOk(schoolId, branchId, id, after))
            ))
        );
    }

    // A parent's read of a finalised result: linked child, published
    // examination, the version in force. Parents fetch by id; a list is not
    // provable for them.
    function parentMayReadResult(schoolId, branchId, d) {
      let exam = get(ttDoc(schoolId, branchId, 'examinations', d.examId)).data;
      return profileIsLinkedParent(callerProfile(), schoolId, branchId, d.studentId)
        && exam.status == 'PUBLISHED' && exam.resultVersion == d.version;
    }

    // ---- Reading documents that may not exist yet -----------------------
    //
    // The app reads a register, marks sheet, submission or result with get()
    // and treats "missing" as "not started". `resource` is null for a missing
    // document, and dereferencing it is an error that denies everyone except
    // the admin short-circuit. These helpers rebuild the fields the read rule
    // needs from the document id (the same ids the create rules enforce), so a
    // missing document is a normal miss for exactly the people who could
    // create it — and stays denied for everyone else.
    function sessionKeyData(sessionId) {
      let p = sessionId.split('__');
      return {'academicYearId': p[1], 'classId': p[2], 'sectionId': p[3]};
    }

    function sheetKeyData(schoolId, branchId, sheetId) {
      let p = sheetId.split('__');
      let exam = get(ttDoc(schoolId, branchId, 'examinations', p[0])).data;
      return {'academicYearId': exam.academicYearId, 'classId': exam.classId,
              'sectionId': p[2], 'subjectId': p[1]};
    }

    function submissionKeyData(submissionId) {
      let p = submissionId.split('__');
      return {'homeworkId': p[0], 'studentId': p[1]};
    }

    function submissionReadable(schoolId, branchId, d) {
      return canManageStaff(schoolId, branchId)
        || isOwnLeaveStaff(schoolId, branchId,
             get(ttDoc(schoolId, branchId, 'homework', d.homeworkId)).data.teacherStaffId)
        || canAccessAsParent(schoolId, branchId, d.studentId);
    }

    function resultKeyData(resultId) {
      let p = resultId.split('__');
      return {'examId': p[0], 'studentId': p[1], 'version': int(p[2][1:])};
    }

    function resultReadable(schoolId, branchId, d) {
      return canManageStaff(schoolId, branchId)
        || (callerIsInBranchAs(schoolId, branchId, 'TEACHER')
            && get(ttDoc(schoolId, branchId, 'examinations', d.examId)).data.status == 'PUBLISHED')
        || parentMayReadResult(schoolId, branchId, d);
    }

    // ---- Notifications & parent–teacher communication (Milestone 11) ----
    //
    // A conversation exists between ONE linked parent and ONE teacher about
    // ONE student. Only the parent starts it (through an ACTIVE, portal-
    // enabled link to a child currently placed in the teacher's section); the
    // teacher must hold the ACTIVE assignment slot (subject, or class teacher)
    // for that section. Membership is the `participants` pair, which no update
    // can change. Messages are create-only: no edit, no delete — reporting
    // flags the conversation (an auditable event) and only then may an
    // administrator read it. See docs/milestone-11-…md.
    function convMessagePath(schoolId, branchId, conversationId, messageId) {
      return /databases/$(database)/documents/schools/$(schoolId)/branches/$(branchId)
        /conversations/$(conversationId)/messages/$(messageId);
    }

    function convTeacherOk(p, schoolId, branchId, d) {
      let slot = slotPath(schoolId, branchId,
        d.academicYearId + '__' + d.classId + '__' + d.sectionId + '__' + d.subjectId);
      let staff = staffPath(schoolId, branchId, d.teacherStaffId);
      return exists(slot) && get(slot).data.teacherStaffId == d.teacherStaffId
        && exists(staff)
        && get(staff).data.userId == d.teacherUserId
        && get(staff).data.status == 'ACTIVE';
    }

    function convEventOk(schoolId, branchId, id, data) {
      let path = ttDoc(schoolId, branchId, 'conversationEvents', id + '__' + string(data.revision));
      return existsAfter(path)
        && getAfter(path).data.event == data.lastEvent
        && getAfter(path).data.toStatus == data.status
        && getAfter(path).data.actorId == request.auth.uid;
    }

    function messageBodyOk(d) {
      return d.body is string && d.body.size() >= 1 && d.body.size() <= 2000
        && d.body.matches('(?s).*\\S.*')
        && d.attachments is list && d.attachments.size() <= 3;
    }

    function conversationUpdateOk(schoolId, branchId, id, before, after) {
      let uid = request.auth.uid;
      let isParent = uid == before.parentUserId;
      let isTeacher = uid == before.teacherUserId;
      let diff = after.diff(before).affectedKeys();
      let msgPath = convMessagePath(schoolId, branchId, id, after.lastMessageId);
      return callerProfile().status == 'ACTIVE' && (isParent || isTeacher
          || profileManages(callerProfile(), schoolId, branchId))
        && after.updatedAt == request.time && after.updatedBy == uid
        && (
          // a new message: same commit as the message document
          ((isParent || isTeacher) && before.status == 'OPEN' && after.status == 'OPEN'
            && after.revision == before.revision
            && after.messageCount == before.messageCount + 1
            && after.lastMessageAt == request.time
            && existsAfter(msgPath)
            && getAfter(msgPath).data.senderUserId == uid
            && (isParent
                ? (after.unreadForTeacher == before.unreadForTeacher + 1
                   && diff.hasOnly(['messageCount', 'lastMessageId', 'lastMessageAt',
                                    'unreadForTeacher', 'updatedAt', 'updatedBy']))
                : (after.unreadForParent == before.unreadForParent + 1
                   && diff.hasOnly(['messageCount', 'lastMessageId', 'lastMessageAt',
                                    'unreadForParent', 'updatedAt', 'updatedBy']))))
          ||
          // reading clears only the reader's own counter
          (after.revision == before.revision && after.status == before.status
            && ((isParent && after.unreadForParent == 0 && after.lastReadParentAt == request.time
                 && diff.hasOnly(['unreadForParent', 'lastReadParentAt', 'updatedAt', 'updatedBy']))
                || (isTeacher && after.unreadForTeacher == 0 && after.lastReadTeacherAt == request.time
                 && diff.hasOnly(['unreadForTeacher', 'lastReadTeacherAt', 'updatedAt', 'updatedBy']))))
          ||
          // status changes: revision + 1 with an event record
          (after.revision == before.revision + 1 && convEventOk(schoolId, branchId, id, after)
            && (
              // either member closes
              ((isParent || isTeacher) && before.status == 'OPEN' && after.status == 'CLOSED'
                && after.lastEvent == 'CLOSED'
                && diff.hasOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              // only the teacher (or an administrator) reopens or archives
              ((isTeacher || profileManages(callerProfile(), schoolId, branchId))
                && before.status == 'CLOSED' && after.status in ['OPEN', 'ARCHIVED']
                && after.lastEvent in ['REOPENED', 'ARCHIVED']
                && diff.hasOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              // a member reports the conversation
              ((isParent || isTeacher) && before.flagged == false && after.flagged == true
                && after.status == before.status && after.lastEvent == 'REPORTED'
                && after.flaggedBy == uid && after.flagReason is string && after.flagReason.size() >= 3
                && after.flaggedAt == request.time
                && diff.hasOnly(['flagged', 'flagReason', 'flaggedBy', 'flaggedAt', 'revision',
                                 'lastEvent', 'updatedAt', 'updatedBy']))
            ))
        );
    }

    // A new-message notification: to the other member, same commit as the
    // message, one per message id (so a retry cannot duplicate it), carrying
    // no message text.
    function messageNotificationOk(schoolId, branchId, notificationId, n) {
      let msg = convMessagePath(schoolId, branchId, n.conversationId, n.messageId);
      let conv = getAfter(ttDoc(schoolId, branchId, 'conversations', n.conversationId)).data;
      return n.conversationId is string && n.messageId is string
        && notificationId == 'msg__' + n.messageId
        && existsAfter(msg)
        && getAfter(msg).data.senderUserId == request.auth.uid
        && n.recipientUserId in conv.participants
        && n.recipientUserId != request.auth.uid;
    }

    // Roles an admin may assign/manage. PLATFORM_ADMIN and SCHOOL_ADMIN can
    // never be granted, or edited, through a client write by a school-scoped
    // admin.
    function schoolAdminManagedRoles() {
      return ['BRANCH_ADMIN', 'TEACHER', 'FINANCE', 'PARENT'];
    }

    function branchAdminManagedRoles() {
      return ['TEACHER', 'FINANCE', 'PARENT'];
    }

    // ---- Self-signup batch -------------------------------------------
    //
    // True only while the caller — who has no profile yet — is, in this
    // same atomic write, creating (1) a school that did not exist before
    // and that they author, and (2) their own SCHOOL_ADMIN profile
    // pointing at exactly that school.
    function isSelfSignupBatchFor(schoolId) {
      return isSignedIn()
        && !hasProfile()
        && !exists(schoolPath(schoolId))
        && existsAfter(schoolPath(schoolId))
        && getAfter(schoolPath(schoolId)).data.createdBy == request.auth.uid
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.schoolId == schoolId
        && getAfter(userPath(request.auth.uid)).data.role == 'SCHOOL_ADMIN';
    }

    // ---- Audit fields --------------------------------------------------
    //
    // Timestamps must be the server's (FieldValue.serverTimestamp() ==
    // request.time) and the actor fields must be the caller — never
    // client-chosen.

    function validCreateAudit() {
      return request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function validUpdateAudit() {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- /users/{userId} ----------------------------------------------
    //
    // Flat (not nested under /schools/{schoolId}) so a client can read its
    // OWN profile to discover its schoolId/branchId/role at sign-in — see
    // FIRESTORE_ARCHITECTURE.md → "Why /users is flat".
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isPlatformAdmin() ||
        (isActiveCaller() && resource.data.schoolId == callerSchoolId() && (
          callerRole() == 'SCHOOL_ADMIN' ||
          (callerRole() == 'BRANCH_ADMIN' && resource.data.branchId == callerBranchId())
        ))
      );

      allow create: if isSignedIn() && validCreateAudit()
        && !('login' in request.resource.data)
        && !('branchRoles' in request.resource.data) && (
        // (a) Self-signup: own profile, SCHOOL_ADMIN of the brand-new school
        //     being created in this same batch — never an existing school.
        (request.auth.uid == userId
          && request.resource.data.schoolId is string
          && isSelfSignupBatchFor(request.resource.data.schoolId)
          && request.resource.data.role == 'SCHOOL_ADMIN'
          && request.resource.data.status == 'ACTIVE')
        ||
        // (b) A school admin (or platform admin) provisioning a subordinate
        //     within their own school.
        (isSchoolAdminOrAbove(request.resource.data.schoolId)
          && request.resource.data.role in schoolAdminManagedRoles()
          && request.resource.data.status in ['ACTIVE', 'INVITED'])
        ||
        // (c) A branch admin provisioning a non-admin within their own branch.
        (isBranchAdminOf(request.resource.data.schoolId, request.resource.data.branchId)
          && request.resource.data.role in branchAdminManagedRoles()
          && request.resource.data.status in ['ACTIVE', 'INVITED'])
      );

      allow update: if isSignedIn() && validUpdateAudit() && (
        // Self, while active: profile fields only. role, schoolId,
        // branchId, status, email, and audit-origin fields are immutable.
        (request.auth.uid == userId
          && resource.data.status == 'ACTIVE'
          && changedOnly(['name', 'phone', 'photoUrl', 'updatedAt', 'updatedBy']))
        ||
        // School admin managing a subordinate in their own school. Can't
        // touch another SCHOOL_ADMIN/PLATFORM_ADMIN, can't grant either
        // role, can't move anyone to another school.
        (isSchoolAdminOf(resource.data.schoolId)
          && resource.data.role in schoolAdminManagedRoles()
          && request.resource.data.role in schoolAdminManagedRoles()
          && request.resource.data.status in ['ACTIVE', 'INVITED', 'DISABLED']
          // linkedParentId: granting a PARENT-role subordinate portal
          // access (Milestone 3) by linking them to a /parents record —
          // see FirebaseParentRepository.linkPortalAccess.
          && changedOnly(['role', 'status', 'branchId', 'name', 'phone', 'photoUrl', 'linkedParentId', 'updatedAt', 'updatedBy']))
        ||
        // Branch admin managing a non-admin in their own branch. Can't move
        // them to another branch.
        (isBranchAdminOf(resource.data.schoolId, resource.data.branchId)
          && resource.data.role in branchAdminManagedRoles()
          && request.resource.data.role in branchAdminManagedRoles()
          && request.resource.data.status in ['ACTIVE', 'INVITED', 'DISABLED']
          && changedOnly(['role', 'status', 'name', 'phone', 'photoUrl', 'linkedParentId', 'updatedAt', 'updatedBy']))
        ||
        isPlatformAdmin()
      );

      // No hard deletes — deactivate via status instead.
      allow delete: if false;
    }

    // ---- /schools/{schoolId} -------------------------------------------
    match /schools/{schoolId} {
      allow read: if isSignedIn() && (isSameSchool(schoolId) || isPlatformAdmin());

      allow create: if validCreateAudit()
        && request.resource.data.status == 'ACTIVE'
        && isSelfSignupBatchFor(schoolId);

      allow update: if isSignedIn() && validUpdateAudit() && (
        // School admins edit the profile, never status (suspension is a
        // platform decision) or the audit-origin fields.
        (isSchoolAdminOf(schoolId)
          && changedOnly([
            'name', 'shortName', 'code', 'logoUrl', 'email', 'phone', 'alternatePhone', 'website',
            'addressLine1', 'addressLine2', 'city', 'state', 'country', 'postalCode', 'defaultBranchId',
            'updatedAt', 'updatedBy',
          ]))
        ||
        isPlatformAdmin()
      );

      allow delete: if false;

      // Which sign-in methods the school enables, and the security audit
      // trail. Both are written ONLY by Cloud Functions (updateSchoolAuthSettings,
      // setLoginAccess); school admins may read them.
      match /authSettings/{docId} {
        allow read: if isSchoolAdminOrAbove(schoolId);
        allow write: if false;
      }
      match /authAudit/{eventId} {
        allow read: if isSchoolAdminOrAbove(schoolId);
        allow write: if false;
      }
      // Grants/revocations of per-branch roles (setBranchAccess, staff
      // deactivation). Cloud Functions write; school admins read.
      match /branchAccessAudit/{eventId} {
        allow read: if isSchoolAdminOrAbove(schoolId);
        allow write: if false;
      }

      // Audit trail of student transfers between branches (written in the same
      // batch as the move; see transferDestinationOk). Immutable.
      match /studentTransfers/{transferId} {
        allow read: if isSchoolAdminOrAbove(schoolId);
        allow create: if isSchoolAdminOf(schoolId)
          && request.resource.data.keys().hasOnly(['schoolId', 'studentId', 'studentName', 'fromBranchId', 'toBranchId',
               'fromAdmissionNumber', 'toAdmissionNumber', 'reason', 'effectiveDate', 'createdAt', 'createdBy'])
          && request.resource.data.schoolId == schoolId
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.fromBranchId is string && request.resource.data.toBranchId is string
          && request.resource.data.fromBranchId != request.resource.data.toBranchId
          && request.resource.data.studentId is string
          && existsAfter(studentPath(schoolId, request.resource.data.toBranchId, request.resource.data.studentId))
          && getAfter(studentPath(schoolId, request.resource.data.toBranchId, request.resource.data.studentId))
               .data.transferredFrom.branchId == request.resource.data.fromBranchId
          && get(studentPath(schoolId, request.resource.data.fromBranchId, request.resource.data.studentId))
               .data.status == 'ACTIVE'
          && getAfter(studentPath(schoolId, request.resource.data.fromBranchId, request.resource.data.studentId))
               .data.status == 'TRANSFERRED';
        allow update, delete: if false;
      }

      // ---- School-wide academic years (registry) ---------------------------
      // One definition per school (name + dates). Each branch OPENS it, which
      // creates its own branches/{b}/academicYears/{sameId} document — all
      // classes, students, fees and results stay branch-owned. A branch year
      // can only be created from (and must match) an ACTIVE registry year, and
      // a linked branch year cannot drift: see branchYearMatchesSchoolYear.
      // The definition is immutable except for archiving it.
      match /academicYears/{schoolYearId} {
        allow read: if isSchoolStaffOf(schoolId);
        allow create: if isSchoolAdminOf(schoolId) && validCreateAudit()
          && request.resource.data.schoolId == schoolId
          && request.resource.data.status == 'ACTIVE'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.startDate is timestamp
          && request.resource.data.endDate is timestamp
          && request.resource.data.endDate > request.resource.data.startDate
          && request.resource.data.keys().hasOnly(['schoolId', 'name', 'startDate', 'endDate', 'status',
               'createdAt', 'updatedAt', 'createdBy', 'updatedBy']);
        allow update: if isSchoolAdminOf(schoolId) && validUpdateAudit()
          && changedOnly(['status', 'updatedAt', 'updatedBy'])
          && request.resource.data.status in ['ACTIVE', 'ARCHIVED'];
        allow delete: if false;
      }

      // ---- /schools/{schoolId}/branches/{branchId} ---------------------
      match /branches/{branchId} {
        allow read: if isSignedIn() && (isSameSchool(schoolId) || isPlatformAdmin());

        allow create: if validCreateAudit()
          && request.resource.data.schoolId == schoolId
          && (
            isSchoolAdminOrAbove(schoolId) ||
            // The default branch, inside the self-signup batch.
            (branchId == 'main' && isSelfSignupBatchFor(schoolId))
          );

        allow update: if isSignedIn() && validUpdateAudit() && (
          (isSchoolAdminOrAbove(schoolId)
            && changedOnly([
              'name', 'code', 'email', 'phone', 'addressLine1', 'addressLine2',
              'city', 'state', 'country', 'postalCode', 'status', 'updatedAt', 'updatedBy',
            ]))
          ||
          (isBranchAdminOf(schoolId, branchId)
            && changedOnly([
              'name', 'code', 'email', 'phone', 'addressLine1', 'addressLine2',
              'city', 'state', 'country', 'postalCode', 'updatedAt', 'updatedBy',
            ]))
        );

        allow delete: if false;

        // ---- academicYears/{id}, and everything nested under a year ---
        // Nested INSIDE branches/{branchId} (not a sibling of it) because
        // that's the real document path every repository/Dart model in
        // this feature writes to — see FIRESTORE_ARCHITECTURE.md.
        match /academicYears/{academicYearId} {
          // Staff read the list and documents. A family may read a single
          // year document (name, dates — the leave form needs the dates) in a
          // branch where it has a child, never list the years.
          allow get: if canViewAcademicSetup(schoolId, branchId) || parentInBranch(schoolId, branchId);
          allow list: if canViewAcademicSetup(schoolId, branchId);
          allow create: if canManageAcademicSetup(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && branchYearMatchesSchoolYear(schoolId, academicYearId, request.resource.data);
          // Years opened from the school-wide registry keep its name and dates;
          // only the branch's own lifecycle (status) changes. Older branch-only
          // years remain fully editable.
          allow update: if canManageAcademicSetup(schoolId, branchId) && validUpdateAudit()
            && (resource.data.get('schoolYearId', null) == null
                ? changedOnly(['name', 'startDate', 'endDate', 'status', 'updatedAt', 'updatedBy'])
                : changedOnly(['status', 'updatedAt', 'updatedBy']));
          allow delete: if false;

          match /classes/{classId} {
            allow read: if canViewAcademicSetup(schoolId, branchId);
            allow create: if canManageAcademicSetup(schoolId, branchId) && validCreateAudit()
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.academicYearId == academicYearId;
            allow update: if canManageAcademicSetup(schoolId, branchId) && validUpdateAudit()
              && changedOnly(['name', 'code', 'displayOrder', 'status', 'updatedAt', 'updatedBy']);
            allow delete: if false;

            match /sections/{sectionId} {
              allow read: if canViewAcademicSetup(schoolId, branchId);
              allow create: if canManageAcademicSetup(schoolId, branchId) && validCreateAudit()
                && request.resource.data.schoolId == schoolId
                && request.resource.data.branchId == branchId
                && request.resource.data.academicYearId == academicYearId
                && request.resource.data.classId == classId;
              allow update: if canManageAcademicSetup(schoolId, branchId) && validUpdateAudit()
                && changedOnly(['name', 'code', 'capacity', 'status', 'updatedAt', 'updatedBy']);
              allow delete: if false;
            }

            // The class-subject relationship (brief §14): doc id ==
            // subjectId, so a subject can only be linked once per class
            // with no separate uniqueness check. Create/delete only —
            // never edited in place; re-link (delete + create) instead
            // of patching a stale snapshot.
            match /classSubjects/{subjectId} {
              allow read: if canViewAcademicSetup(schoolId, branchId);
              allow create: if canManageAcademicSetup(schoolId, branchId)
                && request.resource.data.createdAt == request.time
                && request.resource.data.createdBy == request.auth.uid
                && request.resource.data.schoolId == schoolId
                && request.resource.data.branchId == branchId
                && request.resource.data.academicYearId == academicYearId
                && request.resource.data.classId == classId;
              allow update: if false;
              allow delete: if canManageAcademicSetup(schoolId, branchId);
            }
          }

          match /subjects/{subjectId} {
            allow read: if canViewAcademicSetup(schoolId, branchId);
            allow create: if canManageAcademicSetup(schoolId, branchId) && validCreateAudit()
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.academicYearId == academicYearId;
            allow update: if canManageAcademicSetup(schoolId, branchId) && validUpdateAudit()
              && changedOnly(['name', 'code', 'shortName', 'type', 'displayOrder', 'status', 'updatedAt', 'updatedBy']);
            allow delete: if false;
          }

          match /holidays/{holidayId} {
            allow read: if canViewAcademicSetup(schoolId, branchId);
            allow create: if canManageAcademicSetup(schoolId, branchId) && validCreateAudit()
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.academicYearId == academicYearId;
            allow update: if canManageAcademicSetup(schoolId, branchId) && validUpdateAudit()
              && changedOnly(['date', 'name', 'type', 'description', 'status', 'updatedAt', 'updatedBy']);
            allow delete: if false;
          }
        }

        // ---- settings/{workingDays|academic} — small singleton docs ---
        match /settings/{settingId} {
          allow read: if canViewAcademicSetup(schoolId, branchId);
          allow create, update: if canManageAcademicSetup(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid;
          allow delete: if false;
        }

        // ---- students/{studentId}, and everything nested under one -----
        // (Milestone 3). Not nested under academicYears — a student's
        // identity outlives any single year; see
        // docs/milestone-3-student-parent-management.md → "Why students
        // aren't nested under academicYears".
        match /students/{studentId} {
          allow read: if canViewStudentData(schoolId, branchId) || canAccessAsParent(schoolId, branchId, studentId)
            || teacherHasSection(schoolId, branchId, resource.data.currentClassId, resource.data.currentSectionId);

          allow create: if canManageStudentData(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && ('transferredTo' in request.resource.data) == false
            && (!('transferredFrom' in request.resource.data)
                || transferDestinationOk(schoolId, branchId, studentId, request.resource.data));

          allow update: if canManageStudentData(schoolId, branchId) && validUpdateAudit()
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['transferredTo'])
                || transferSourceOk(schoolId, branchId, studentId, resource.data, request.resource.data))
            // A student who has been moved to another branch stays TRANSFERRED here.
            && (!('transferredTo' in resource.data) || request.resource.data.status == 'TRANSFERRED')
            && changedOnly([
              'transferredTo',
              'admissionNumber', 'studentCode', 'firstName', 'middleName', 'lastName',
              'displayName', 'displayNameLower', 'dateOfBirth', 'gender', 'bloodGroup', 'photoUrl',
              'email', 'phone', 'addressLine1', 'addressLine2', 'city', 'state', 'country', 'postalCode',
              'admissionDate', 'status', 'statusChangeReason', 'statusChangeDate', 'statusChangeNotes',
              'currentAcademicYearId', 'currentClassId', 'currentSectionId', 'currentRollNumber',
              'updatedAt', 'updatedBy',
            ]);

          allow delete: if false;

          // The real academic-history source of truth — see Student.
          // Never updated in place beyond closing out (status/endDate) or
          // correcting the roll number; a placement change always creates
          // a new record instead (brief §6: "never overwrite history").
          match /academicRecords/{recordId} {
            allow read: if canViewStudentData(schoolId, branchId) || canAccessAsParent(schoolId, branchId, studentId)
              || teacherOfStudent(schoolId, branchId, studentId);
            allow create: if canManageStudentData(schoolId, branchId) && validCreateAudit()
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.studentId == studentId;
            allow update: if canManageStudentData(schoolId, branchId) && validUpdateAudit()
              && changedOnly(['status', 'endDate', 'rollNumber', 'updatedAt', 'updatedBy']);
            allow delete: if false;
          }

          // Doc id == parentId, so "already linked" is existence, not a
          // query — see ParentStudentLink's doc comment.
          match /parentLinks/{parentId} {
            allow read: if canViewStudentData(schoolId, branchId) || (
              isActiveCaller() && callerRole() == 'PARENT' && callerSchoolId() == schoolId
                && callerProfile().linkedParentId == parentId
            ) || teacherOfStudent(schoolId, branchId, studentId);
            allow create: if canManageStudentData(schoolId, branchId) && validCreateAudit()
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.studentId == studentId
              && request.resource.data.parentId == parentId;
            allow update: if canManageStudentData(schoolId, branchId) && validUpdateAudit()
              && changedOnly(['relationshipType', 'isPrimary', 'isEmergencyContact', 'canAccessPortal', 'status', 'updatedAt', 'updatedBy']);
            allow delete: if false;
          }
        }

        // ---- teacherAccess/{uid} ----------------------------------------
        // Which sections a teacher is assigned to (see teacherHasSection).
        // Written only by Cloud Functions; a teacher may read their own, an
        // administrator may read any (support / "Check access").
        match /teacherAccess/{uid} {
          allow read: if request.auth.uid == uid || canManageStaff(schoolId, branchId);
          allow write: if false;
        }

        // ---- parentAccess/{parentId} (Milestone 12A) --------------------
        // The rules-readable summary of where a family has children. Written
        // only by staff who manage student data, as a by-product of linking a
        // parent or placing/withdrawing a student; never by the family.
        match /parentAccess/{parentId} {
          allow read: if canViewStudentData(schoolId, branchId)
            || (isFamilyCaller(schoolId) && callerProfile().linkedParentId == parentId);
          allow create, update: if canManageStudentData(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.parentId == parentId
            && request.resource.data.classKeys is list && request.resource.data.classKeys.size() <= 100
            && request.resource.data.sectionKeys is list && request.resource.data.sectionKeys.size() <= 200
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid;
          allow delete: if false;
        }

        // ---- parents/{parentId} (Milestone 3) ---------------------------
        match /parents/{parentId} {
          allow list: if canViewStudentData(schoolId, branchId) || (
            isActiveCaller() && callerRole() == 'PARENT' && callerSchoolId() == schoolId
              && callerProfile().linkedParentId == parentId
          );
          // A teacher can open one parent (shown on their student's profile),
          // only when that family has a child in a section they teach.
          allow get: if canViewStudentData(schoolId, branchId) || (
            isActiveCaller() && callerRole() == 'PARENT' && callerSchoolId() == schoolId
              && callerProfile().linkedParentId == parentId
          ) || teacherOfParent(schoolId, branchId, parentId);

          allow create: if canManageStudentData(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId;

          // linkedUserId is included here (not immutable) — granting
          // portal access is an ordinary admin edit to this record, same
          // authorization as any other field here. The /users/{uid} side
          // of that same link is written separately, through the /users
          // update rule's own PLATFORM_ADMIN-only `isPlatformAdmin()`
          // branch — a school/branch admin cannot grant themselves or
          // anyone else a role change by writing through this path.
          allow update: if canManageStudentData(schoolId, branchId) && validUpdateAudit()
            && changedOnly([
              'firstName', 'middleName', 'lastName', 'displayName', 'displayNameLower',
              'phone', 'alternatePhone', 'email', 'occupation', 'photoUrl',
              'addressLine1', 'addressLine2', 'city', 'state', 'country', 'postalCode',
              'status', 'linkedUserId', 'updatedAt', 'updatedBy',
            ]);

          allow delete: if false;
        }

        // ---- Staff + Teacher management (Milestone 4) -----------------------
        // See docs/milestone-4-staff-teacher-management.md.

        // Doc id == lower-cased code, so a code exists once per branch:
        // `create` on an existing id is an update, which is denied.
        match /departments/{departmentId} {
          allow read: if canViewAcademicSetup(schoolId, branchId);
          allow create: if canManageStaff(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'ACTIVE'
            && validConfigCode(request.resource.data, departmentId);
          allow update: if canManageStaff(schoolId, branchId) && validUpdateAudit()
            && changedOnly(['name', 'description', 'status', 'updatedAt', 'updatedBy']);
          allow delete: if false;
        }

        match /designations/{designationId} {
          allow read: if canViewAcademicSetup(schoolId, branchId);
          allow create: if canManageStaff(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'ACTIVE'
            && validConfigCode(request.resource.data, designationId);
          allow update: if canManageStaff(schoolId, branchId) && validUpdateAudit()
            && changedOnly(['name', 'description', 'status', 'updatedAt', 'updatedBy']);
          allow delete: if false;
        }

        // Employee-code reservations: one doc per code (id == lower-cased
        // code). Created in the same batch as the staff record that holds
        // it and released only when no staff record holds it any more — so
        // "one employee code per branch" is enforced by the database, not
        // by a racy client-side query.
        match /staffCodes/{codeId} {
          allow read: if canManageStaff(schoolId, branchId);
          allow create: if canManageStaff(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.createdAt == request.time
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.staffId is string
            && existsAfter(staffPath(schoolId, branchId, request.resource.data.staffId))
            && getAfter(staffPath(schoolId, branchId, request.resource.data.staffId)).data.employeeCodeLower == codeId;
          allow update: if false;
          allow delete: if canManageStaff(schoolId, branchId)
            && (!existsAfter(staffPath(schoolId, branchId, resource.data.staffId))
              || getAfter(staffPath(schoolId, branchId, resource.data.staffId)).data.employeeCodeLower != codeId);
        }

        match /staff/{staffId} {
          allow read: if canViewStaff(schoolId, branchId) || isOwnStaffRecord(schoolId, branchId, resource.data);

          allow create: if canManageStaff(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.userId == null
            && request.resource.data.employeeCode is string
            && request.resource.data.employeeCode.matches('^[A-Za-z0-9_-]{2,20}$')
            && request.resource.data.employeeCodeLower == request.resource.data.employeeCode.lower()
            && existsAfter(staffCodePath(schoolId, branchId, request.resource.data.employeeCodeLower))
            && getAfter(staffCodePath(schoolId, branchId, request.resource.data.employeeCodeLower)).data.staffId == staffId
            && isActiveConfigEntry(departmentPath(schoolId, branchId, request.resource.data.departmentId))
            && isActiveConfigEntry(designationPath(schoolId, branchId, request.resource.data.designationId));

          // schoolId, branchId and the audit-origin fields are not in this
          // list: a record cannot be moved to another school/branch.
          allow update: if canManageStaff(schoolId, branchId) && validUpdateAudit()
            && changedOnly([
              'employeeCode', 'employeeCodeLower', 'firstName', 'middleName', 'lastName',
              'displayName', 'displayNameLower', 'photoUrl', 'dateOfBirth', 'gender', 'bloodGroup',
              'phone', 'alternatePhone', 'email', 'emailLower',
              'address', 'city', 'state', 'country', 'postalCode',
              'joiningDate', 'employmentType', 'departmentId', 'designationId', 'isTeacher', 'userId',
              'status', 'statusChangeReason', 'statusChangeDate', 'statusChangeNotes',
              'updatedAt', 'updatedBy',
            ])
            // Resigned / terminated / retired are final.
            && (request.resource.data.status == resource.data.status || !isTerminalStaffStatus(resource.data.status))
            // A changed employee code must arrive with its new reservation.
            && (request.resource.data.employeeCodeLower == resource.data.employeeCodeLower || (
              request.resource.data.employeeCode.matches('^[A-Za-z0-9_-]{2,20}$')
              && request.resource.data.employeeCodeLower == request.resource.data.employeeCode.lower()
              && existsAfter(staffCodePath(schoolId, branchId, request.resource.data.employeeCodeLower))
              && getAfter(staffCodePath(schoolId, branchId, request.resource.data.employeeCodeLower)).data.staffId == staffId))
            && (request.resource.data.departmentId == resource.data.departmentId
              || isActiveConfigEntry(departmentPath(schoolId, branchId, request.resource.data.departmentId)))
            && (request.resource.data.designationId == resource.data.designationId
              || isActiveConfigEntry(designationPath(schoolId, branchId, request.resource.data.designationId)))
            // A linked application account must exist in this same school.
            && (request.resource.data.userId == resource.data.userId || request.resource.data.userId == null
              || get(userPath(request.resource.data.userId)).data.schoolId == schoolId);

          allow delete: if false;

          // Metadata only — the files live in Storage. Sensitive (ID
          // proofs, certificates): managers only, never finance/teachers.
          match /documents/{documentId} {
            allow read: if canManageStaff(schoolId, branchId);
            allow create: if canManageStaff(schoolId, branchId) && validCreateAudit()
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.staffId == staffId
              && request.resource.data.status == 'ACTIVE'
              && request.resource.data.storagePath is string
              && request.resource.data.storagePath.matches(
                'schools/' + schoolId + '/branches/' + branchId + '/staff/' + staffId + '/documents/.*');
            allow update: if canManageStaff(schoolId, branchId) && validUpdateAudit()
              && changedOnly(['status', 'updatedAt', 'updatedBy'])
              && request.resource.data.status in ['ACTIVE', 'REMOVED'];
            allow delete: if false;
          }
        }

        // One row per teacher x section x subject x year; ended rows are
        // kept as history. Readable by managers/finance and by the
        // teacher the row belongs to (resolved through the staff record's
        // userId link) — never by other teachers.
        match /teacherAssignments/{assignmentId} {
          // Staff managers; the owner (any status — their own history); and,
          // for ACTIVE assignments only, any teacher of the branch. An
          // ACTIVE assignment is "who teaches what" — no personal data, and
          // already visible through the live timetable. The app reads the
          // year's ACTIVE list for every teacher (announcement audience,
          // homework options, marks sheets); this is what lets that query be
          // proven by `status == 'ACTIVE'`. Colleagues' staff records stay
          // private (see /staff).
          allow read: if canViewStaff(schoolId, branchId) || (
            callerWorksInBranch(schoolId, branchId)
              && (resource.data.status == 'ACTIVE' && callerRoleIn(branchId) == 'TEACHER'
                  || get(staffPath(schoolId, branchId, resource.data.teacherStaffId)).data.userId == request.auth.uid)
          );

          // Every reference is verified here — the client's IDs are not
          // trusted: the teacher is an ACTIVE teacher of this branch, the
          // section is active (its path ties it to the class + academic
          // year), the subject is linked to that class, and the
          // uniqueness slot is claimed in the same batch.
          allow create: if canManageStaff(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.endDate == null
            && request.resource.data.isClassTeacher is bool
            && (request.resource.data.isClassTeacher
              ? request.resource.data.subjectId == null
              : request.resource.data.subjectId is string)
            && get(staffPath(schoolId, branchId, request.resource.data.teacherStaffId)).data.status == 'ACTIVE'
            && get(staffPath(schoolId, branchId, request.resource.data.teacherStaffId)).data.isTeacher == true
            && get(sectionPath(schoolId, branchId, request.resource.data.academicYearId,
                request.resource.data.classId, request.resource.data.sectionId)).data.status == 'ACTIVE'
            && (request.resource.data.isClassTeacher
              || exists(classSubjectPath(schoolId, branchId, request.resource.data.academicYearId,
                request.resource.data.classId, request.resource.data.subjectId)))
            && existsAfter(slotPath(schoolId, branchId, slotKeyOf(request.resource.data)))
            && getAfter(slotPath(schoolId, branchId, slotKeyOf(request.resource.data))).data.assignmentId == assignmentId
            && getAfter(slotPath(schoolId, branchId, slotKeyOf(request.resource.data))).data.teacherStaffId
              == request.resource.data.teacherStaffId;

          // Only ACTIVE -> ENDED, and only if the slot is released in the
          // same batch.
          allow update: if canManageStaff(schoolId, branchId) && validUpdateAudit()
            && changedOnly(['status', 'endDate', 'updatedAt', 'updatedBy'])
            && resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'ENDED'
            && request.resource.data.endDate is timestamp
            && !existsAfter(slotPath(schoolId, branchId, slotKeyOf(resource.data)));

          allow delete: if false;
        }

        // Active-assignment reservations (see TeacherAssignment.slotKeyFor):
        // at most one ACTIVE teacher per section+subject+year and one class
        // teacher per section+year. The doc id is the key, so a second
        // claim on a held slot is an update, which is denied.
        match /assignmentSlots/{slotKey} {
          allow read: if canManageStaff(schoolId, branchId);
          allow create: if canManageStaff(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.createdAt == request.time
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.assignmentId is string
            && existsAfter(assignmentPath(schoolId, branchId, request.resource.data.assignmentId))
            && slotKeyOf(getAfter(assignmentPath(schoolId, branchId, request.resource.data.assignmentId)).data) == slotKey;
          allow update: if false;
          allow delete: if canManageStaff(schoolId, branchId)
            && existsAfter(assignmentPath(schoolId, branchId, resource.data.assignmentId))
            && getAfter(assignmentPath(schoolId, branchId, resource.data.assignmentId)).data.status == 'ENDED';
        }

        // ---- Attendance (Milestone 5) ----------------------------------------
        // See docs/milestone-5-attendance-management.md.

        // One register per section per date: DRAFT / FINALIZED + maintained
        // counts. The finalized flag is what locks the student records below.
        match /attendanceSessions/{sessionId} {
          // A register that has not been started yet does not exist, and the
          // app reads it with get(): judge a missing one by the section its
          // id names (dateKey__year__class__section), as the create rule does.
          allow read: if canMarkStudentAttendance(schoolId, branchId,
            resource != null ? resource.data : sessionKeyData(sessionId));

          allow create: if validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && validDateKey(request.resource.data.dateKey)
            && sessionId == attendanceSessionKey(request.resource.data)
            && notFutureAttendance(request.resource.data)
            && request.resource.data.status in ['DRAFT', 'FINALIZED']
            && request.resource.data.revision == 1
            && validDayCounts(request.resource.data)
            && validDayFinalization(request.resource.data)
            && canMarkStudentAttendance(schoolId, branchId, request.resource.data);

          // A finalized register can only be touched (corrected or
          // re-opened) by a manager.
          allow update: if validUpdateAudit()
            && changedOnly([
              'status', 'enrolled', 'present', 'absent', 'late', 'halfDay', 'notMarked',
              'dayKind', 'overrideReason', 'revision', 'finalizedAt', 'finalizedBy', 'updatedAt', 'updatedBy',
            ])
            && request.resource.data.status in ['DRAFT', 'FINALIZED']
            && request.resource.data.revision == resource.data.revision + 1
            && validDayCounts(request.resource.data)
            && validDayFinalization(request.resource.data)
            && canMarkStudentAttendance(schoolId, branchId, resource.data)
            && (resource.data.status != 'FINALIZED' || canManageAttendance(schoolId, branchId));

          allow delete: if false;
        }

        match /studentAttendance/{attendanceId} {
          allow read: if canMarkStudentAttendance(schoolId, branchId, resource.data);

          // The id is date + student, so there is exactly one record per
          // student per date; a second create is an update (below).
          allow create: if validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && validDateKey(request.resource.data.dateKey)
            && attendanceId == request.resource.data.dateKey + '_' + request.resource.data.studentId
            && notFutureAttendance(request.resource.data)
            && validAttendanceStatus(request.resource.data.status)
            && request.resource.data.revision == 1
            && validRemarks(request.resource.data)
            && canMarkStudentAttendance(schoolId, branchId, request.resource.data)
            && (!isFinalizedDay(attendanceSessionPath(schoolId, branchId, attendanceSessionKey(request.resource.data)))
              || (canManageAttendance(schoolId, branchId) && validChangeReason(request.resource.data)));

          // Only status / remarks / reason change; the student, date and the
          // class-section-year snapshot are fixed. Revision must advance by
          // exactly one (the client's transaction compares it to detect a
          // concurrent edit). Finalized => manager + written reason.
          allow update: if validUpdateAudit()
            && changedOnly(['status', 'remarks', 'revision', 'lastChangeReason', 'updatedAt', 'updatedBy'])
            && validAttendanceStatus(request.resource.data.status)
            && request.resource.data.revision == resource.data.revision + 1
            && validRemarks(request.resource.data)
            && canMarkStudentAttendance(schoolId, branchId, resource.data)
            && (!isFinalizedDay(attendanceSessionPath(schoolId, branchId, attendanceSessionKey(resource.data)))
              || (canManageAttendance(schoolId, branchId) && validChangeReason(request.resource.data)));

          allow delete: if false;

          // Immutable audit trail, one entry per revision.
          match /history/{revisionId} {
            allow read: if canMarkStudentAttendance(schoolId, branchId, resource.data);
            allow create: if request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.dateKey + '_' + request.resource.data.studentId == attendanceId
              && request.resource.data.revision is int
              && revisionId == string(request.resource.data.revision)
              && validAttendanceStatus(request.resource.data.newStatus)
              && request.resource.data.changedBy == request.auth.uid
              && request.resource.data.changedAt == request.time
              && canMarkStudentAttendance(schoolId, branchId, request.resource.data);
            allow update, delete: if false;
          }
        }

        // Staff attendance: managers write; finance reads (payroll
        // groundwork); a staff member reads their own days.
        match /staffAttendanceDays/{dateKey} {
          allow read: if canViewStaff(schoolId, branchId);
          allow create: if canManageAttendance(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && validDateKey(dateKey) && request.resource.data.dateKey == dateKey
            && notFutureAttendance(request.resource.data)
            && request.resource.data.status in ['DRAFT', 'FINALIZED']
            && request.resource.data.revision == 1
            && validDayCounts(request.resource.data)
            && validDayFinalization(request.resource.data);
          allow update: if canManageAttendance(schoolId, branchId) && validUpdateAudit()
            && changedOnly([
              'status', 'enrolled', 'present', 'absent', 'late', 'halfDay', 'notMarked',
              'dayKind', 'overrideReason', 'revision', 'finalizedAt', 'finalizedBy', 'updatedAt', 'updatedBy',
            ])
            && request.resource.data.status in ['DRAFT', 'FINALIZED']
            && request.resource.data.revision == resource.data.revision + 1
            && validDayCounts(request.resource.data)
            && validDayFinalization(request.resource.data);
          allow delete: if false;
        }

        match /staffAttendance/{attendanceId} {
          allow read: if canViewStaff(schoolId, branchId) || (
            callerWorksInBranch(schoolId, branchId)
              && get(staffPath(schoolId, branchId, resource.data.staffId)).data.userId == request.auth.uid
          );

          allow create: if canManageAttendance(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && validDateKey(request.resource.data.dateKey)
            && attendanceId == request.resource.data.dateKey + '_' + request.resource.data.staffId
            && notFutureAttendance(request.resource.data)
            && validAttendanceStatus(request.resource.data.status)
            && request.resource.data.revision == 1
            && validRemarks(request.resource.data)
            && (!isFinalizedDay(staffAttendanceDayPath(schoolId, branchId, request.resource.data.dateKey))
              || validChangeReason(request.resource.data));

          allow update: if canManageAttendance(schoolId, branchId) && validUpdateAudit()
            && changedOnly(['status', 'remarks', 'revision', 'lastChangeReason', 'updatedAt', 'updatedBy'])
            && validAttendanceStatus(request.resource.data.status)
            && request.resource.data.revision == resource.data.revision + 1
            && validRemarks(request.resource.data)
            && (!isFinalizedDay(staffAttendanceDayPath(schoolId, branchId, resource.data.dateKey))
              || validChangeReason(request.resource.data));

          allow delete: if false;

          match /history/{revisionId} {
            allow read: if canManageAttendance(schoolId, branchId);
            allow create: if canManageAttendance(schoolId, branchId)
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.dateKey + '_' + request.resource.data.staffId == attendanceId
              && request.resource.data.revision is int
              && revisionId == string(request.resource.data.revision)
              && validAttendanceStatus(request.resource.data.newStatus)
              && request.resource.data.changedBy == request.auth.uid
              && request.resource.data.changedAt == request.time;
            allow update, delete: if false;
          }
        }

        // ---- Fees (Milestone 6) ------------------------------------------------
        // See docs/milestone-6-fees-management.md.

        // Id = academicYearId__codeLower: one structure per code per year.
        match /feeStructures/{structureId} {
          allow read: if canFeeStaff(schoolId, branchId);
          allow create: if canFeeAdmin(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.code is string
            && request.resource.data.code.matches('^[A-Za-z0-9_-]{2,20}$')
            && structureId == request.resource.data.academicYearId + '__' + request.resource.data.code.lower()
            && request.resource.data.frequency in ['ONE_TIME', 'MONTHLY', 'QUARTERLY', 'HALF_YEARLY', 'ANNUAL', 'CUSTOM']
            && request.resource.data.category in ['TUITION', 'ADMISSION', 'EXAMINATION', 'TRANSPORT', 'BOOKS', 'UNIFORM', 'ACTIVITY', 'OTHER']
            && isPositiveMinor(request.resource.data.amountMinor)
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          // Year, code and tenant ids are the identity; everything else may be
          // edited — and editing never touches an issued invoice (they hold
          // their own snapshot).
          allow update: if canFeeAdmin(schoolId, branchId) && validUpdateAudit()
            && changedOnly([
              'name', 'category', 'customCategoryLabel', 'frequency', 'amountMinor', 'classId', 'sectionId', 'isOptional',
              'effectiveFromKey', 'effectiveToKey', 'dueOffsetDays', 'description', 'paymentInstructions', 'status',
              'updatedAt', 'updatedBy',
            ])
            && request.resource.data.frequency in ['ONE_TIME', 'MONTHLY', 'QUARTERLY', 'HALF_YEARLY', 'ANNUAL', 'CUSTOM']
            && isPositiveMinor(request.resource.data.amountMinor)
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          allow delete: if false;
        }

        // Id = studentId__structureId: a fee head is assigned to a student once.
        match /studentFeeAssignments/{assignmentId} {
          allow read: if canFeeStaff(schoolId, branchId) || canAccessAsParent(schoolId, branchId, resource.data.studentId);
          allow create: if canFeeStaff(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && assignmentId == request.resource.data.studentId + '__' + request.resource.data.structureId
            && request.resource.data.status == 'ACTIVE'
            && get(feeDoc(schoolId, branchId, 'feeStructures', request.resource.data.structureId)).data.status == 'ACTIVE'
            && get(feeDoc(schoolId, branchId, 'feeStructures', request.resource.data.structureId)).data.academicYearId
              == request.resource.data.academicYearId
            && (request.resource.data.concessionType == 'NONE'
              ? request.resource.data.concessionValue == 0
              : (canFeeAdmin(schoolId, branchId)
                && request.resource.data.concessionType in ['PERCENT', 'FIXED']
                && isPositiveMinor(request.resource.data.concessionValue)
                && (request.resource.data.concessionType == 'FIXED' || request.resource.data.concessionValue <= 10000)
                && validFeeReason(request.resource.data.concessionReason)
                && request.resource.data.concessionApprovedBy == request.auth.uid));
          // Cancel / re-activate (finance) or change the concession (admin only).
          allow update: if validUpdateAudit() && (
            (canFeeStaff(schoolId, branchId) && changedOnly(['status', 'updatedAt', 'updatedBy'])
              && request.resource.data.status in ['ACTIVE', 'CANCELLED'])
            ||
            (canFeeAdmin(schoolId, branchId)
              && changedOnly(['concessionType', 'concessionValue', 'concessionReason', 'concessionApprovedBy', 'updatedAt', 'updatedBy'])
              && request.resource.data.concessionApprovedBy == request.auth.uid
              && (request.resource.data.concessionType == 'NONE'
                ? request.resource.data.concessionValue == 0
                : (request.resource.data.concessionType in ['PERCENT', 'FIXED']
                  && isPositiveMinor(request.resource.data.concessionValue)
                  && (request.resource.data.concessionType == 'FIXED' || request.resource.data.concessionValue <= 10000)
                  && validFeeReason(request.resource.data.concessionReason))))
          );
          allow delete: if false;
        }

        // Number sequences. The counter only ever grows; a reserved number
        // must lie in the range the counter moved through in the SAME commit,
        // and its document id is unique forever — so no number is ever issued
        // twice, however many clients race. (Gaps are possible and harmless.)
        match /feeCounters/{counterId} {
          allow read: if canFeeStaff(schoolId, branchId);
          allow create: if canFeeStaff(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.last is int && request.resource.data.last >= 1 && request.resource.data.last <= 1000
            && request.resource.data.updatedBy == request.auth.uid;
          allow update: if canFeeStaff(schoolId, branchId)
            && changedOnly(['last', 'updatedAt', 'updatedBy'])
            && request.resource.data.last is int
            && request.resource.data.last > resource.data.last
            && request.resource.data.last <= resource.data.last + 1000
            && request.resource.data.updatedBy == request.auth.uid;
          allow delete: if false;
        }

        match /invoiceNumbers/{number} {
          allow read: if canFeeStaff(schoolId, branchId);
          allow create: if canFeeStaff(schoolId, branchId)
            && number.matches('^INV-[0-9]{4}-[0-9]{6,}$')
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.numberSeq is int
            && request.resource.data.numberSeq > counterLast(feeDoc(schoolId, branchId, 'feeCounters', 'invoice_' + request.resource.data.academicYearId))
            && request.resource.data.numberSeq <= getAfter(feeDoc(schoolId, branchId, 'feeCounters', 'invoice_' + request.resource.data.academicYearId)).data.last;
          allow update, delete: if false;
        }

        match /receiptNumbers/{number} {
          allow read: if canFeeStaff(schoolId, branchId);
          allow create: if canFeeStaff(schoolId, branchId)
            && number.matches('^RCT-[0-9]{4}-[0-9]{6,}$')
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.numberSeq is int
            && request.resource.data.numberSeq > counterLast(feeDoc(schoolId, branchId, 'feeCounters', 'receipt_' + request.resource.data.academicYearId))
            && request.resource.data.numberSeq <= getAfter(feeDoc(schoolId, branchId, 'feeCounters', 'receipt_' + request.resource.data.academicYearId)).data.last;
          allow update, delete: if false;
        }

        // Id = studentId__yearId__periodKey: one invoice per student per
        // period. The snapshot (lines, subtotal, discount, payable, number,
        // student, period) is immutable; only the derived money fields move,
        // each only together with the record that justifies it.
        match /invoices/{invoiceId} {
          allow read: if canFeeStaff(schoolId, branchId) || canAccessAsParent(schoolId, branchId, resource.data.studentId);

          allow create: if canFeeStaff(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && invoiceId == request.resource.data.studentId + '__' + request.resource.data.academicYearId + '__' + request.resource.data.periodKey
            && request.resource.data.status == 'ISSUED'
            && request.resource.data.lines is list
            && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 20
            && isPositiveMinor(request.resource.data.payableMinor)
            && isMinor(request.resource.data.subtotalMinor) && isMinor(request.resource.data.discountMinor)
            && request.resource.data.payableMinor == request.resource.data.subtotalMinor - request.resource.data.discountMinor
            && request.resource.data.waivedMinor == 0 && request.resource.data.paidMinor == 0
            && request.resource.data.balanceMinor == request.resource.data.payableMinor
            && request.resource.data.issueDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.dueDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.dueDateKey >= request.resource.data.issueDateKey
            && existsAfter(feeDoc(schoolId, branchId, 'invoiceNumbers', request.resource.data.invoiceNumber))
            && getAfter(feeDoc(schoolId, branchId, 'invoiceNumbers', request.resource.data.invoiceNumber)).data.numberSeq == request.resource.data.numberSeq
            && get(feeDoc(schoolId, branchId, 'students', request.resource.data.studentId)).data.status == 'ACTIVE';

          allow update: if validUpdateAudit()
            && resource.data.status != 'VOID'
            && (
              // a payment recorded in this same commit
              (request.resource.data.lastEventType == 'PAYMENT' && canFeeStaff(schoolId, branchId)
                && changedOnly(['paidMinor', 'balanceMinor', 'status', 'lastEventType', 'lastEventId', 'updatedAt', 'updatedBy'])
                && !exists(feeDoc(schoolId, branchId, 'payments', request.resource.data.lastEventId))
                && existsAfter(feeDoc(schoolId, branchId, 'payments', request.resource.data.lastEventId))
                && getAfter(feeDoc(schoolId, branchId, 'payments', request.resource.data.lastEventId)).data.invoiceId == invoiceId
                && getAfter(feeDoc(schoolId, branchId, 'payments', request.resource.data.lastEventId)).data.status == 'ACTIVE'
                && getAfter(feeDoc(schoolId, branchId, 'payments', request.resource.data.lastEventId)).data.amountMinor <= resource.data.balanceMinor
                && request.resource.data.paidMinor == resource.data.paidMinor
                  + getAfter(feeDoc(schoolId, branchId, 'payments', request.resource.data.lastEventId)).data.amountMinor
                && request.resource.data.balanceMinor == resource.data.payableMinor - resource.data.waivedMinor - request.resource.data.paidMinor
                && request.resource.data.status == invoiceStatusFor(resource.data.payableMinor, resource.data.waivedMinor, request.resource.data.paidMinor))
              ||
              // a payment reversed / refunded in this same commit
              (request.resource.data.lastEventType == 'REVERSAL' && canFeeAdmin(schoolId, branchId)
                && changedOnly(['paidMinor', 'balanceMinor', 'status', 'lastEventType', 'lastEventId', 'updatedAt', 'updatedBy'])
                && !exists(feeDoc(schoolId, branchId, 'paymentReversals', request.resource.data.lastEventId))
                && existsAfter(feeDoc(schoolId, branchId, 'paymentReversals', request.resource.data.lastEventId))
                && getAfter(feeDoc(schoolId, branchId, 'paymentReversals', request.resource.data.lastEventId)).data.invoiceId == invoiceId
                && request.resource.data.paidMinor == resource.data.paidMinor
                  - getAfter(feeDoc(schoolId, branchId, 'paymentReversals', request.resource.data.lastEventId)).data.amountMinor
                && request.resource.data.paidMinor >= 0
                && request.resource.data.balanceMinor == resource.data.payableMinor - resource.data.waivedMinor - request.resource.data.paidMinor
                && request.resource.data.status == invoiceStatusFor(resource.data.payableMinor, resource.data.waivedMinor, request.resource.data.paidMinor))
              ||
              // an approved waiver recorded in this same commit
              (request.resource.data.lastEventType == 'WAIVER' && canFeeAdmin(schoolId, branchId)
                && changedOnly(['waivedMinor', 'balanceMinor', 'status', 'lastEventType', 'lastEventId', 'updatedAt', 'updatedBy'])
                && !exists(feeDoc(schoolId, branchId, 'invoiceWaivers', request.resource.data.lastEventId))
                && existsAfter(feeDoc(schoolId, branchId, 'invoiceWaivers', request.resource.data.lastEventId))
                && getAfter(feeDoc(schoolId, branchId, 'invoiceWaivers', request.resource.data.lastEventId)).data.invoiceId == invoiceId
                && getAfter(feeDoc(schoolId, branchId, 'invoiceWaivers', request.resource.data.lastEventId)).data.amountMinor <= resource.data.balanceMinor
                && request.resource.data.waivedMinor == resource.data.waivedMinor
                  + getAfter(feeDoc(schoolId, branchId, 'invoiceWaivers', request.resource.data.lastEventId)).data.amountMinor
                && request.resource.data.balanceMinor == resource.data.payableMinor - request.resource.data.waivedMinor - resource.data.paidMinor
                && request.resource.data.status == invoiceStatusFor(resource.data.payableMinor, request.resource.data.waivedMinor, resource.data.paidMinor))
              ||
              // voided — only when nothing is paid
              (request.resource.data.lastEventType == 'VOID' && canFeeAdmin(schoolId, branchId)
                && changedOnly(['status', 'voidReason', 'voidedAt', 'voidedBy', 'lastEventType', 'lastEventId', 'updatedAt', 'updatedBy'])
                && resource.data.paidMinor == 0
                && request.resource.data.status == 'VOID'
                && request.resource.data.voidedBy == request.auth.uid
                && request.resource.data.voidedAt == request.time
                && validFeeReason(request.resource.data.voidReason))
            );
          allow delete: if false;
        }

        // Releases an invoice line's lock when (and only when) the invoice is voided.
        match /feeCharges/{chargeId} {
          allow read: if canFeeStaff(schoolId, branchId);
          allow create: if canFeeStaff(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.invoiceId is string
            && request.resource.data.assignmentId is string
            && chargeId.matches('^' + request.resource.data.assignmentId + '__.+$');
          allow update: if false;
          allow delete: if canFeeAdmin(schoolId, branchId)
            && getAfter(feeDoc(schoolId, branchId, 'invoices', resource.data.invoiceId)).data.status == 'VOID';
        }

        // The id IS the idempotency key: a retried submission addresses the
        // same document and cannot add a second payment.
        match /payments/{paymentId} {
          allow read: if canFeeStaff(schoolId, branchId) || canAccessAsParent(schoolId, branchId, resource.data.studentId);

          allow create: if canFeeStaff(schoolId, branchId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.collectedBy == request.auth.uid
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'ACTIVE'
            && isPositiveMinor(request.resource.data.amountMinor)
            && request.resource.data.method in ['CASH', 'UPI', 'BANK_TRANSFER', 'CHEQUE', 'OTHER']
            && (request.resource.data.method in ['CASH', 'OTHER']
              || (request.resource.data.referenceNo is string && request.resource.data.referenceNo.size() >= 3))
            && request.resource.data.paymentDateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            // against a real, open invoice of this branch, for this student
            && get(feeDoc(schoolId, branchId, 'invoices', request.resource.data.invoiceId)).data.status in ['ISSUED', 'PARTIALLY_PAID']
            && get(feeDoc(schoolId, branchId, 'invoices', request.resource.data.invoiceId)).data.studentId == request.resource.data.studentId
            && get(feeDoc(schoolId, branchId, 'invoices', request.resource.data.invoiceId)).data.academicYearId == request.resource.data.academicYearId
            && request.resource.data.amountMinor <= get(feeDoc(schoolId, branchId, 'invoices', request.resource.data.invoiceId)).data.balanceMinor
            && request.resource.data.balanceAfterMinor
              == get(feeDoc(schoolId, branchId, 'invoices', request.resource.data.invoiceId)).data.balanceMinor - request.resource.data.amountMinor
            // and the invoice is moved by exactly this payment, in this commit
            && getAfter(feeDoc(schoolId, branchId, 'invoices', request.resource.data.invoiceId)).data.lastEventId == paymentId
            && existsAfter(feeDoc(schoolId, branchId, 'receipts', paymentId))
            && getAfter(feeDoc(schoolId, branchId, 'receipts', paymentId)).data.amountMinor == request.resource.data.amountMinor;

          // The only change a payment can ever undergo: ACTIVE -> REVERSED,
          // together with its reversal record.
          allow update: if canFeeAdmin(schoolId, branchId) && validUpdateAudit()
            && changedOnly(['status', 'updatedAt', 'updatedBy'])
            && resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'REVERSED'
            && existsAfter(feeDoc(schoolId, branchId, 'paymentReversals', paymentId))
            // ...and the invoice gives the money back in the same commit, so a
            // reversed payment can never keep counting as paid.
            && getAfter(feeDoc(schoolId, branchId, 'invoices', resource.data.invoiceId)).data.lastEventType == 'REVERSAL'
            && getAfter(feeDoc(schoolId, branchId, 'invoices', resource.data.invoiceId)).data.lastEventId == paymentId;
          allow delete: if false;
        }

        match /receipts/{receiptId} {
          allow read: if canFeeStaff(schoolId, branchId) || canAccessAsParent(schoolId, branchId, resource.data.studentId);
          allow create: if canFeeStaff(schoolId, branchId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.paymentId == receiptId
            && request.resource.data.status == 'ACTIVE'
            && isPositiveMinor(request.resource.data.amountMinor)
            && existsAfter(feeDoc(schoolId, branchId, 'receiptNumbers', request.resource.data.receiptNumber))
            && getAfter(feeDoc(schoolId, branchId, 'receiptNumbers', request.resource.data.receiptNumber)).data.numberSeq == request.resource.data.numberSeq;
          allow update: if canFeeAdmin(schoolId, branchId) && validUpdateAudit()
            && changedOnly(['status', 'updatedAt', 'updatedBy'])
            && resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'REVERSED'
            && existsAfter(feeDoc(schoolId, branchId, 'paymentReversals', receiptId));
          allow delete: if false;
        }

        // Append-only. Id = the payment's id => a payment is reversed once.
        match /paymentReversals/{paymentId} {
          allow read: if canFeeStaff(schoolId, branchId);
          allow create: if canFeeAdmin(schoolId, branchId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.reversedBy == request.auth.uid
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.kind in ['REVERSAL', 'REFUND']
            && validFeeReason(request.resource.data.reason)
            && get(feeDoc(schoolId, branchId, 'payments', paymentId)).data.status == 'ACTIVE'
            && getAfter(feeDoc(schoolId, branchId, 'payments', paymentId)).data.status == 'REVERSED'
            && request.resource.data.amountMinor == get(feeDoc(schoolId, branchId, 'payments', paymentId)).data.amountMinor
            && request.resource.data.invoiceId == get(feeDoc(schoolId, branchId, 'payments', paymentId)).data.invoiceId
            && request.resource.data.studentId == get(feeDoc(schoolId, branchId, 'payments', paymentId)).data.studentId;
          allow update, delete: if false;
        }

        match /invoiceWaivers/{waiverId} {
          allow read: if canFeeStaff(schoolId, branchId);
          allow create: if canFeeAdmin(schoolId, branchId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.approvedBy == request.auth.uid
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && isPositiveMinor(request.resource.data.amountMinor)
            && validFeeReason(request.resource.data.reason);
          allow update, delete: if false;
        }

        // Who did what to the money and when (structure changes, concessions,
        // waivers, voids, reversals). Append-only.
        match /financialAuditLogs/{logId} {
          allow read: if canFeeAdmin(schoolId, branchId);
          allow create: if canFeeStaff(schoolId, branchId)
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.type is string;
          allow update, delete: if false;
        }

        // ---- Leave (Milestone 7) ---------------------------------------
        match /leaveSettings/{settingId} {
          allow read: if canReviewLeave(schoolId, branchId);
          allow create, update: if canReviewLeave(schoolId, branchId) && settingId == 'policy'
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.allowAdminOnBehalf is bool
            && request.resource.data.updatedBy == request.auth.uid;
          allow delete: if false;
        }

        // Leave types are configuration every signed-in member of the school
        // may read (parents pick a type, staff pick a type). Only admins write.
        // Never deleted: deactivate, so applications keep their reference.
        match /leaveTypes/{typeId} {
          allow read: if isActiveCaller() && callerSchoolId() == schoolId;
          allow create: if canReviewLeave(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.kind in ['STUDENT', 'STAFF']
            && request.resource.data.code is string
            && request.resource.data.code.matches('^[A-Za-z0-9_-]{2,20}$')
            && typeId == request.resource.data.kind + '__' + request.resource.data.code.lower()
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
            && request.resource.data.payType in ['PAID', 'UNPAID', 'NA']
            && (request.resource.data.kind == 'STUDENT'
              ? (request.resource.data.payType == 'NA' && request.resource.data.annualEntitlementUnits == null)
              : request.resource.data.payType in ['PAID', 'UNPAID'])
            && (request.resource.data.annualEntitlementUnits == null
              || (request.resource.data.annualEntitlementUnits is int
                && request.resource.data.annualEntitlementUnits >= 1
                && request.resource.data.annualEntitlementUnits <= 732))
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          allow update: if canReviewLeave(schoolId, branchId) && validUpdateAudit()
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.kind == resource.data.kind
            && request.resource.data.code == resource.data.code
            && (request.resource.data.kind == 'STUDENT'
              ? (request.resource.data.payType == 'NA' && request.resource.data.annualEntitlementUnits == null)
              : request.resource.data.payType in ['PAID', 'UNPAID'])
            && (request.resource.data.annualEntitlementUnits == null
              || (request.resource.data.annualEntitlementUnits is int
                && request.resource.data.annualEntitlementUnits >= 1
                && request.resource.data.annualEntitlementUnits <= 732))
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          allow delete: if false;
        }

        match /leaveApplications/{applicationId} {
          allow read: if canReviewLeave(schoolId, branchId)
            || resource.data.applicantUserId == request.auth.uid
            || (resource.data.subjectKind == 'STUDENT'
              && canAccessAsParent(schoolId, branchId, resource.data.subjectId))
            || (resource.data.subjectKind == 'STAFF'
              && isOwnLeaveStaff(schoolId, branchId, resource.data.subjectId));

          allow create: if isActiveCaller()
            && request.resource.data.applicantUserId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.status == 'PENDING'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'SUBMIT'
            && request.resource.data.get('decidedBy', null) == null
            && validLeaveBody(schoolId, branchId, request.resource.data)
            && leaveHistoryMatches(schoolId, branchId, applicationId, 1, null, 'PENDING', 'SUBMIT')
            // who may file for whom
            && (
              (request.resource.data.subjectKind == 'STUDENT' && request.resource.data.relation == 'PARENT'
                && canAccessAsParent(schoolId, branchId, request.resource.data.subjectId))
              || (request.resource.data.subjectKind == 'STAFF' && request.resource.data.relation == 'SELF'
                && isOwnLeaveStaff(schoolId, branchId, request.resource.data.subjectId))
              || (request.resource.data.relation == 'ADMIN' && canReviewLeave(schoolId, branchId)
                && leaveAdminOnBehalfAllowed(schoolId, branchId))
            );

          allow update: if isActiveCaller()
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.subjectKind == resource.data.subjectKind
            && request.resource.data.subjectId == resource.data.subjectId
            && request.resource.data.applicantUserId == resource.data.applicantUserId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.revision == resource.data.revision + 1
            && leaveHistoryMatches(schoolId, branchId, applicationId, request.resource.data.revision,
                 resource.data.status, request.resource.data.status, request.resource.data.lastEvent)
            && (
              // The applicant withdraws a pending or returned application.
              (resource.data.applicantUserId == request.auth.uid
                && resource.data.status in ['PENDING', 'RETURNED']
                && request.resource.data.status == 'WITHDRAWN'
                && request.resource.data.lastEvent == 'WITHDRAW'
                && changedOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              // The applicant corrects and resubmits a returned application.
              (resource.data.applicantUserId == request.auth.uid
                && resource.data.status == 'RETURNED'
                && request.resource.data.status == 'PENDING'
                && request.resource.data.lastEvent == 'RESUBMIT'
                && request.resource.data.decidedBy == null
                && validLeaveBody(schoolId, branchId, request.resource.data))
              ||
              // A reviewer decides a pending application. Never their own.
              (canReviewLeave(schoolId, branchId)
                && request.auth.uid != resource.data.applicantUserId
                && (resource.data.subjectKind != 'STAFF'
                  || leaveStaffUserId(schoolId, branchId, resource.data.subjectId) != request.auth.uid)
                && resource.data.status == 'PENDING'
                && request.resource.data.status in ['APPROVED', 'REJECTED', 'RETURNED']
                && request.resource.data.lastEvent
                    == (request.resource.data.status == 'APPROVED' ? 'APPROVE'
                        : (request.resource.data.status == 'REJECTED' ? 'REJECT' : 'RETURN'))
                && request.resource.data.decidedBy == request.auth.uid
                && request.resource.data.decidedAt == request.time
                && (request.resource.data.status == 'APPROVED'
                    || (request.resource.data.decisionRemarks is string && request.resource.data.decisionRemarks.size() >= 3))
                && changedOnly(['status', 'revision', 'lastEvent', 'decidedBy', 'decidedByName', 'decidedAt',
                                'decisionRemarks', 'updatedAt', 'updatedBy'])
                // approval publishes the calendar entry and, for tracked staff
                // leave, consumes the balance — in this same commit
                && (request.resource.data.status != 'APPROVED'
                    || (existsAfter(leaveDoc(schoolId, branchId, 'leaveCalendar', applicationId))
                        && (resource.data.balanceId == null
                            || (existsAfter(leaveDoc(schoolId, branchId, 'leaveLedger', applicationId + '__consume'))
                                && getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', applicationId + '__consume')).data.units
                                   == resource.data.units
                                && getAfter(leaveDoc(schoolId, branchId, 'leaveBalances', resource.data.balanceId)).data.lastLedgerId
                                   == applicationId + '__consume')))))
              ||
              // A reviewer cancels an APPROVED leave: calendar entry cancelled
              // and consumed leave restored in the same commit.
              (canReviewLeave(schoolId, branchId)
                && request.auth.uid != resource.data.applicantUserId
                && resource.data.status == 'APPROVED'
                && request.resource.data.status == 'CANCELLED'
                && request.resource.data.lastEvent == 'CANCEL'
                && request.resource.data.decisionRemarks is string && request.resource.data.decisionRemarks.size() >= 3
                && changedOnly(['status', 'revision', 'lastEvent', 'decisionRemarks', 'decidedBy', 'decidedByName',
                                'decidedAt', 'updatedAt', 'updatedBy'])
                && getAfter(leaveDoc(schoolId, branchId, 'leaveCalendar', applicationId)).data.status == 'CANCELLED'
                && (resource.data.balanceId == null
                    || (existsAfter(leaveDoc(schoolId, branchId, 'leaveLedger', applicationId + '__restore'))
                        && getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', applicationId + '__restore')).data.units
                           == resource.data.units
                        && getAfter(leaveDoc(schoolId, branchId, 'leaveBalances', resource.data.balanceId)).data.lastLedgerId
                           == applicationId + '__restore')))
            );
          allow delete: if false;
        }

        // Append-only decision history: who moved the application from what to
        // what, when, and why. `{applicationId}__{revision}`.
        match /leaveHistory/{entryId} {
          allow read: if canReviewLeave(schoolId, branchId)
            || resource.data.applicantUserId == request.auth.uid
            || (resource.data.subjectKind == 'STUDENT'
              && canAccessAsParent(schoolId, branchId, resource.data.subjectId))
            || (resource.data.subjectKind == 'STAFF'
              && isOwnLeaveStaff(schoolId, branchId, resource.data.subjectId));
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && entryId == request.resource.data.applicationId + '__' + string(request.resource.data.revision)
            && existsAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId))
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.revision
               == request.resource.data.revision
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.status
               == request.resource.data.toStatus;
          allow update, delete: if false;
        }

        // The minimal, non-sensitive public face of an approved leave.
        match /leaveCalendar/{applicationId} {
          allow read: if canReviewLeave(schoolId, branchId)
            || (resource.data.subjectKind == 'STUDENT' && canViewStudentData(schoolId, branchId))
            || (resource.data.subjectKind == 'STUDENT'
              && teacherHasSection(schoolId, branchId, resource.data.get('classId', null), resource.data.get('sectionId', null)))
            || (resource.data.subjectKind == 'STUDENT'
              && canAccessAsParent(schoolId, branchId, resource.data.subjectId))
            || (resource.data.subjectKind == 'STAFF'
              && isOwnLeaveStaff(schoolId, branchId, resource.data.subjectId));
          allow create: if canReviewLeave(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'ACTIVE'
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', applicationId)).data.status == 'APPROVED'
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', applicationId)).data.subjectId
               == request.resource.data.subjectId
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', applicationId)).data.startDateKey
               == request.resource.data.startDateKey
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', applicationId)).data.endDateKey
               == request.resource.data.endDateKey;
          allow update: if canReviewLeave(schoolId, branchId)
            && changedOnly(['status'])
            && resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'CANCELLED'
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', applicationId)).data.status == 'CANCELLED';
          allow delete: if false;
        }

        // One doc per subject per date per session: makes overlapping
        // applications impossible even when two are submitted at once.
        match /leaveDayLocks/{lockId} {
          allow get: if (resource == null && isActiveCaller() && callerSchoolId() == schoolId)
            || (resource != null && (resource.data.lockedBy == request.auth.uid || canReviewLeave(schoolId, branchId)));
          allow list: if canReviewLeave(schoolId, branchId);
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.lockedBy == request.auth.uid
            && request.resource.data.applicationId is string
            && existsAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId))
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.applicantUserId
               == request.auth.uid
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.status
               in ['PENDING']
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.subjectId
               == request.resource.data.subjectId;
          // A lock is released only when its application stops holding days.
          allow delete: if (resource.data.lockedBy == request.auth.uid || canReviewLeave(schoolId, branchId))
            && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', resource.data.applicationId)).data.status
               in ['WITHDRAWN', 'REJECTED', 'RETURNED', 'CANCELLED'];
          allow update: if false;
        }

        // A staff member's balance of one type for one leave year. Only
        // reviewers write it, only together with a ledger entry.
        match /leaveBalances/{balanceId} {
          allow read: if canReviewLeave(schoolId, branchId)
            || isOwnLeaveStaff(schoolId, branchId, resource.data.staffId);
          allow create: if canReviewLeave(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && balanceId == request.resource.data.staffId + '__' + request.resource.data.typeId + '__'
                 + request.resource.data.academicYearId
            && exists(leaveDoc(schoolId, branchId, 'leaveTypes', request.resource.data.typeId))
            && request.resource.data.entitlementUnits
               == get(leaveDoc(schoolId, branchId, 'leaveTypes', request.resource.data.typeId)).data.annualEntitlementUnits
            && request.resource.data.adjustmentUnits == 0
            && request.resource.data.carryForwardUnits >= 0
            && request.resource.data.carryForwardUnits
               <= get(leaveDoc(schoolId, branchId, 'leaveTypes', request.resource.data.typeId)).data.carryForwardMaxUnits
            && request.resource.data.consumedUnits >= 0
            && (request.resource.data.carryForwardUnits == 0 || existsAfter(leaveDoc(schoolId, branchId, 'leaveLedger', balanceId + '__carry')))
            && (request.resource.data.consumedUnits == 0
              || (request.resource.data.lastLedgerId is string
                && getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.entryType == 'CONSUME'
                && getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.units
                   == request.resource.data.consumedUnits));
          allow update: if canReviewLeave(schoolId, branchId) && validUpdateAudit()
            && changedOnly(['consumedUnits', 'adjustmentUnits', 'lastLedgerId', 'updatedAt', 'updatedBy'])
            && request.resource.data.lastLedgerId is string
            && !exists(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId))
            && getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.balanceId == balanceId
            && (
              (getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.entryType == 'CONSUME'
                && request.resource.data.adjustmentUnits == resource.data.adjustmentUnits
                && request.resource.data.consumedUnits == resource.data.consumedUnits
                   + getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.units
                && (resource.data.exceedPolicy == 'WARN'
                    || request.resource.data.consumedUnits <= resource.data.entitlementUnits
                       + resource.data.carryForwardUnits + resource.data.adjustmentUnits))
              ||
              (getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.entryType == 'RESTORE'
                && request.resource.data.adjustmentUnits == resource.data.adjustmentUnits
                && request.resource.data.consumedUnits == resource.data.consumedUnits
                   - getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.units
                && request.resource.data.consumedUnits >= 0)
              ||
              (getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.entryType == 'ADJUSTMENT'
                && request.resource.data.consumedUnits == resource.data.consumedUnits
                && request.resource.data.adjustmentUnits == resource.data.adjustmentUnits
                   + getAfter(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.lastLedgerId)).data.units)
            );
          allow delete: if false;
        }

        // Append-only. CONSUME/RESTORE ids are `{applicationId}__consume|restore`
        // so a retried approval or cancellation cannot count twice.
        match /leaveLedger/{entryId} {
          allow read: if canReviewLeave(schoolId, branchId)
            || isOwnLeaveStaff(schoolId, branchId, resource.data.staffId);
          allow create: if canReviewLeave(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.units is int
            && request.resource.data.entryType in ['CONSUME', 'RESTORE', 'ADJUSTMENT', 'CARRY_FORWARD']
            && request.resource.data.balanceId == request.resource.data.staffId + '__' + request.resource.data.typeId
                 + '__' + request.resource.data.academicYearId
            && (
              (request.resource.data.entryType == 'CONSUME'
                && request.resource.data.units > 0
                && entryId == request.resource.data.applicationId + '__consume'
                && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.status == 'APPROVED'
                && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.units
                   == request.resource.data.units)
              ||
              (request.resource.data.entryType == 'RESTORE'
                && request.resource.data.units > 0
                && entryId == request.resource.data.applicationId + '__restore'
                && exists(leaveDoc(schoolId, branchId, 'leaveLedger', request.resource.data.applicationId + '__consume'))
                && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.status == 'CANCELLED')
              ||
              (request.resource.data.entryType == 'ADJUSTMENT'
                && request.resource.data.units != 0
                && request.resource.data.units >= -732 && request.resource.data.units <= 732
                && validFeeReason(request.resource.data.reason))
              ||
              (request.resource.data.entryType == 'CARRY_FORWARD'
                && request.resource.data.units > 0
                && entryId == request.resource.data.balanceId + '__carry')
            );
          allow update, delete: if false;
        }

        // In-app notifications. Written in the SAME transaction as the event
        // they announce, so one exists exactly when its event happened (a retry
        // fails the status precondition and writes nothing). The recipient may
        // only mark their own as read. 'REVIEWERS' notices are for any reviewer.
        match /notifications/{notificationId} {
          allow read: if (resource.data.audience == 'USER' && resource.data.recipientUserId == request.auth.uid)
            || (resource.data.audience == 'REVIEWERS' && canReviewLeave(schoolId, branchId));
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.audience in ['USER', 'REVIEWERS']
            && request.resource.data.type in ['LEAVE_SUBMITTED', 'LEAVE_APPROVED', 'LEAVE_REJECTED',
                 'LEAVE_RETURNED', 'LEAVE_WITHDRAWN', 'LEAVE_CANCELLED', 'LEAVE_BALANCE_ADJUSTED',
                 'TIMETABLE_PUBLISHED', 'SUBSTITUTION_ASSIGNED', 'SUBSTITUTION_CHANGED', 'SUBSTITUTION_CANCELLED']
            && (
              (request.resource.data.type == 'LEAVE_BALANCE_ADJUSTED' && canReviewLeave(schoolId, branchId))
              ||
              // timetable published: written by the manager who published it,
              // to a user, in the commit that published it
              (request.resource.data.type == 'TIMETABLE_PUBLISHED'
                && canManageTimetable(schoolId, branchId)
                && request.resource.data.audience == 'USER'
                && existsAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId))
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.status == 'PUBLISHED'
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.publishedBy
                   == request.auth.uid
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.revision
                   == request.resource.data.revision)
              ||
              // substitution events: by the manager, in the commit of the event
              (request.resource.data.type in ['SUBSTITUTION_ASSIGNED', 'SUBSTITUTION_CHANGED', 'SUBSTITUTION_CANCELLED']
                && canManageTimetable(schoolId, branchId)
                && request.resource.data.audience == 'USER'
                && existsAfter(ttDoc(schoolId, branchId, 'substitutions', request.resource.data.substitutionId))
                && getAfter(ttDoc(schoolId, branchId, 'substitutions', request.resource.data.substitutionId)).data.revision
                   == request.resource.data.revision
                && {'ASSIGNED': 'SUBSTITUTION_ASSIGNED', 'REINSTATED': 'SUBSTITUTION_ASSIGNED',
                    'CHANGED': 'SUBSTITUTION_CHANGED', 'CANCELLED': 'SUBSTITUTION_CANCELLED'}[
                      getAfter(ttDoc(schoolId, branchId, 'substitutions', request.resource.data.substitutionId)).data.lastEvent]
                   == request.resource.data.type
                && getAfter(ttDoc(schoolId, branchId, 'substitutions', request.resource.data.substitutionId)).data.updatedBy
                   == request.auth.uid)
              ||
              (request.resource.data.type in ['LEAVE_SUBMITTED', 'LEAVE_APPROVED', 'LEAVE_REJECTED',
                   'LEAVE_RETURNED', 'LEAVE_WITHDRAWN', 'LEAVE_CANCELLED']
                && existsAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId))
                && getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.revision
                   == request.resource.data.revision
                // the type announces exactly the event that just happened...
                && {'SUBMIT': 'LEAVE_SUBMITTED', 'RESUBMIT': 'LEAVE_SUBMITTED', 'WITHDRAW': 'LEAVE_WITHDRAWN',
                    'APPROVE': 'LEAVE_APPROVED', 'REJECT': 'LEAVE_REJECTED', 'RETURN': 'LEAVE_RETURNED',
                    'CANCEL': 'LEAVE_CANCELLED'}[getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.lastEvent]
                   == request.resource.data.type
                // ...and is written by a party to it: the applicant (their own
                // submit/withdraw) or a reviewer (a decision).
                && (getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.updatedBy
                      == request.auth.uid)
                && (request.resource.data.audience == 'REVIEWERS'
                    || request.resource.data.recipientUserId
                       == getAfter(leaveDoc(schoolId, branchId, 'leaveApplications', request.resource.data.applicationId)).data.applicantUserId))
            );
          allow update: if resource.data.audience == 'USER' && resource.data.recipientUserId == request.auth.uid
            && changedOnly(['readAt']);
          allow delete: if false;
        }

        // Homework returned / graded: a targeted notice to the user who
        // submitted, written by the reviewer in the commit of that change. A
        // separate match (rules from overlapping matches are OR-ed) so the
        // leave and timetable notification rule above keeps its headroom. No
        // marks or feedback text in the notice. Reading and marking read are
        // the rules of the match above.
        match /notifications/{notificationId} {
          allow create: if isActiveCaller()
            && request.resource.data.type in ['HOMEWORK_RETURNED', 'HOMEWORK_GRADED']
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.audience == 'USER'
            && homeworkNotificationOk(schoolId, branchId, notificationId, request.resource.data);
        }

        // ---- Timetable & substitution (Milestone 8) --------------------
        match /periodSets/{periodSetId} {
          allow read: if canManageTimetable(schoolId, branchId);
          allow create: if canManageTimetable(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
            && request.resource.data.slots is list
            && request.resource.data.slots.size() >= 1 && request.resource.data.slots.size() <= 20
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          allow update: if canManageTimetable(schoolId, branchId) && validUpdateAudit()
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.academicYearId == resource.data.academicYearId
            && request.resource.data.slots is list
            && request.resource.data.slots.size() >= 1 && request.resource.data.slots.size() <= 20
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          allow delete: if false;
        }

        // Per-section version counter: ids are unique and increasing.
        match /timetableCounters/{sectionKey} {
          allow read: if canManageTimetable(schoolId, branchId);
          allow create: if canManageTimetable(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.last == 1
            && request.resource.data.updatedBy == request.auth.uid;
          allow update: if canManageTimetable(schoolId, branchId)
            && changedOnly(['last', 'updatedAt', 'updatedBy'])
            && request.resource.data.last == resource.data.last + 1
            && request.resource.data.updatedBy == request.auth.uid;
          allow delete: if false;
        }

        // The branch publication lock (see the helper comment above).
        match /timetableLocks/{lockId} {
          allow read: if canManageTimetable(schoolId, branchId);
          allow create: if canManageTimetable(schoolId, branchId) && lockId == 'branch'
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.publishSeq == 1
            && request.resource.data.updatedBy == request.auth.uid;
          allow update: if canManageTimetable(schoolId, branchId)
            && changedOnly(['publishSeq', 'updatedAt', 'updatedBy'])
            && request.resource.data.publishSeq == resource.data.publishSeq + 1
            && request.resource.data.updatedBy == request.auth.uid;
          allow delete: if false;
        }

        match /timetables/{timetableId} {
          allow read: if canManageTimetable(schoolId, branchId)
            || (resource.data.status == 'PUBLISHED' && canReadSectionContent(schoolId, branchId, resource.data));

          allow create: if canManageTimetable(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'DRAFT'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'CREATED'
            && request.resource.data.publishedBy == null
            && request.resource.data.version is int && request.resource.data.version >= 1
            && timetableId == request.resource.data.academicYearId + '__' + request.resource.data.classId
                 + '__' + request.resource.data.sectionId + '__v' + string(request.resource.data.version)
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
            && validEffectiveRange(request.resource.data)
            && request.resource.data.dayPeriodSets is map
            && request.resource.data.dayPeriodSets.size() >= 1
            && request.resource.data.entryCount is int
            && request.resource.data.teacherIds is list
            && get(sectionPath(schoolId, branchId, request.resource.data.academicYearId,
                 request.resource.data.classId, request.resource.data.sectionId)).data.status == 'ACTIVE'
            // the version comes from the section's counter, in this commit
            && existsAfter(ttDoc(schoolId, branchId, 'timetableCounters',
                 request.resource.data.academicYearId + '__' + request.resource.data.classId + '__' + request.resource.data.sectionId))
            && getAfter(ttDoc(schoolId, branchId, 'timetableCounters',
                 request.resource.data.academicYearId + '__' + request.resource.data.classId + '__' + request.resource.data.sectionId)).data.last
               == request.resource.data.version
            && (exists(ttDoc(schoolId, branchId, 'timetableCounters',
                 request.resource.data.academicYearId + '__' + request.resource.data.classId + '__' + request.resource.data.sectionId))
                ? get(ttDoc(schoolId, branchId, 'timetableCounters',
                    request.resource.data.academicYearId + '__' + request.resource.data.classId + '__' + request.resource.data.sectionId)).data.last
                    == request.resource.data.version - 1
                : request.resource.data.version == 1)
            && timetableHistoryOk(schoolId, branchId, timetableId, request.resource.data);

          allow update: if canManageTimetable(schoolId, branchId) && validUpdateAudit()
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.academicYearId == resource.data.academicYearId
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.sectionId == resource.data.sectionId
            && request.resource.data.version == resource.data.version
            && request.resource.data.revision == resource.data.revision + 1
            && timetableHistoryOk(schoolId, branchId, timetableId, request.resource.data)
            && (
              // edit a draft
              (resource.data.status == 'DRAFT' && request.resource.data.status == 'DRAFT'
                && request.resource.data.lastEvent == 'EDITED'
                && changedOnly(['name', 'dayPeriodSets', 'effectiveFromKey', 'effectiveToKey', 'entryCount',
                                'teacherIds', 'revision', 'lastEvent', 'updatedAt', 'updatedBy'])
                && validEffectiveRange(request.resource.data)
                && request.resource.data.dayPeriodSets is map && request.resource.data.dayPeriodSets.size() >= 1)
              ||
              // publish
              (resource.data.status == 'DRAFT' && request.resource.data.status == 'PUBLISHED'
                && request.resource.data.lastEvent == 'PUBLISHED'
                && request.resource.data.publishedBy == request.auth.uid
                && request.resource.data.publishedAt == request.time
                && resource.data.entryCount >= 1
                && changedOnly(['status', 'revision', 'lastEvent', 'publishedBy', 'publishedAt', 'lockSeq',
                                'updatedAt', 'updatedBy'])
                && publishLockBumped(schoolId, branchId)
                && request.resource.data.lockSeq
                   == getAfter(ttDoc(schoolId, branchId, 'timetableLocks', 'branch')).data.publishSeq)
              ||
              // a published version fully replaced by a newer published one
              (resource.data.status == 'PUBLISHED' && request.resource.data.status == 'ARCHIVED'
                && request.resource.data.lastEvent == 'SUPERSEDED'
                && changedOnly(['status', 'revision', 'lastEvent', 'supersededBy', 'lockSeq', 'updatedAt', 'updatedBy'])
                && request.resource.data.supersededBy is string
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.supersededBy)).data.status == 'PUBLISHED'
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.supersededBy)).data.classId
                   == resource.data.classId
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.supersededBy)).data.sectionId
                   == resource.data.sectionId
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.supersededBy)).data.academicYearId
                   == resource.data.academicYearId
                && publishLockBumped(schoolId, branchId))
              ||
              // a published version that started earlier ends the day before
              (resource.data.status == 'PUBLISHED' && request.resource.data.status == 'PUBLISHED'
                && request.resource.data.lastEvent == 'TRUNCATED'
                && changedOnly(['effectiveToKey', 'revision', 'lastEvent', 'supersededBy', 'lockSeq',
                                'updatedAt', 'updatedBy'])
                && validDateKey(request.resource.data.effectiveToKey)
                && request.resource.data.effectiveToKey >= resource.data.effectiveFromKey
                && (resource.data.effectiveToKey == null
                    || request.resource.data.effectiveToKey < resource.data.effectiveToKey)
                && request.resource.data.supersededBy is string
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.supersededBy)).data.status == 'PUBLISHED'
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.supersededBy)).data.classId
                   == resource.data.classId
                && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.supersededBy)).data.sectionId
                   == resource.data.sectionId
                && publishLockBumped(schoolId, branchId))
              ||
              // discard a draft
              (resource.data.status == 'DRAFT' && request.resource.data.status == 'ARCHIVED'
                && request.resource.data.lastEvent == 'ARCHIVED'
                && changedOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              // withdraw a published version
              (resource.data.status == 'PUBLISHED' && request.resource.data.status == 'ARCHIVED'
                && request.resource.data.lastEvent == 'ARCHIVED'
                && changedOnly(['status', 'revision', 'lastEvent', 'lockSeq', 'updatedAt', 'updatedBy'])
                && publishLockBumped(schoolId, branchId))
            );
          allow delete: if false;
        }

        match /timetableEntries/{entryId} {
          allow read: if canManageTimetable(schoolId, branchId)
            || (resource.data.live == true
                && (canReadSectionContent(schoolId, branchId, resource.data)
                    || isOwnLeaveStaff(schoolId, branchId, resource.data.teacherStaffId)));

          allow create: if canManageTimetable(schoolId, branchId)
            && entryId == request.resource.data.timetableId + '__' + request.resource.data.weekday
                 + '__' + request.resource.data.slotId
            && validEntryBody(schoolId, branchId, request.resource.data.timetableId, request.resource.data);

          allow update: if canManageTimetable(schoolId, branchId)
            && (
              // a draft cell edited
              (request.resource.data.timetableId == resource.data.timetableId
                && request.resource.data.weekday == resource.data.weekday
                && request.resource.data.slotId == resource.data.slotId
                && validEntryBody(schoolId, branchId, resource.data.timetableId, request.resource.data))
              ||
              // `live` follows the timetable's status, changed in the same commit
              (changedOnly(['live'])
                && request.resource.data.live
                   == (getAfter(ttDoc(schoolId, branchId, 'timetables', resource.data.timetableId)).data.status == 'PUBLISHED')
                && getAfter(ttDoc(schoolId, branchId, 'timetables', resource.data.timetableId)).data.revision
                   != get(ttDoc(schoolId, branchId, 'timetables', resource.data.timetableId)).data.revision)
            );

          allow delete: if canManageTimetable(schoolId, branchId)
            && get(ttDoc(schoolId, branchId, 'timetables', resource.data.timetableId)).data.status == 'DRAFT';
        }

        // Who published / withdrew / replaced what. Append-only.
        match /timetableHistory/{entryId} {
          allow read: if canManageTimetable(schoolId, branchId);
          allow create: if canManageTimetable(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && entryId == request.resource.data.timetableId + '__' + string(request.resource.data.revision)
            && existsAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId))
            && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.revision
               == request.resource.data.revision
            && getAfter(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.status
               == request.resource.data.toStatus;
          allow update, delete: if false;
        }

        match /substitutionDays/{dateKey} {
          allow read: if canManageTimetable(schoolId, branchId);
          allow create: if canManageTimetable(schoolId, branchId) && validDateKey(dateKey)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.seq == 1
            && request.resource.data.updatedBy == request.auth.uid;
          allow update: if canManageTimetable(schoolId, branchId)
            && changedOnly(['seq', 'updatedAt', 'updatedBy'])
            && request.resource.data.seq == resource.data.seq + 1
            && request.resource.data.updatedBy == request.auth.uid;
          allow delete: if false;
        }

        // A date-specific cover. The timetable is never rewritten.
        match /substitutions/{substitutionId} {
          allow read: if canManageTimetable(schoolId, branchId)
            || isOwnLeaveStaff(schoolId, branchId, resource.data.substituteTeacherId)
            || isOwnLeaveStaff(schoolId, branchId, resource.data.originalTeacherId)
            || (resource.data.status == 'ACTIVE' && canReadSectionContent(schoolId, branchId, resource.data));

          allow create: if canManageTimetable(schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && validDateKey(request.resource.data.dateKey)
            && substitutionId == request.resource.data.dateKey + '__' + request.resource.data.timetableId
                 + '__' + request.resource.data.slotId
            && request.resource.data.entryId == request.resource.data.timetableId + '__'
                 + request.resource.data.weekday + '__' + request.resource.data.slotId
            && request.resource.data.status == 'ACTIVE'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'ASSIGNED'
            && request.resource.data.reasonKind in ['LEAVE', 'ABSENCE', 'DUTY', 'OTHER']
            && validSubstituteTeacher(schoolId, branchId, request.resource.data)
            // for a real, live entry of a published timetable that covers the date
            && get(ttDoc(schoolId, branchId, 'timetableEntries', request.resource.data.entryId)).data.live == true
            && get(ttDoc(schoolId, branchId, 'timetableEntries', request.resource.data.entryId)).data.teacherStaffId
               == request.resource.data.originalTeacherId
            && get(ttDoc(schoolId, branchId, 'timetableEntries', request.resource.data.entryId)).data.subjectId
               == request.resource.data.subjectId
            && get(ttDoc(schoolId, branchId, 'timetableEntries', request.resource.data.entryId)).data.classId
               == request.resource.data.classId
            && get(ttDoc(schoolId, branchId, 'timetableEntries', request.resource.data.entryId)).data.sectionId
               == request.resource.data.sectionId
            && get(ttDoc(schoolId, branchId, 'timetableEntries', request.resource.data.entryId)).data.startMin
               == request.resource.data.startMin
            && get(ttDoc(schoolId, branchId, 'timetableEntries', request.resource.data.entryId)).data.endMin
               == request.resource.data.endMin
            && get(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.status == 'PUBLISHED'
            && get(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.effectiveFromKey
               <= request.resource.data.dateKey
            && (get(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.effectiveToKey == null
                || request.resource.data.dateKey
                   <= get(ttDoc(schoolId, branchId, 'timetables', request.resource.data.timetableId)).data.effectiveToKey)
            && substitutionDayBumped(schoolId, branchId, request.resource.data.dateKey)
            && substitutionHistoryOk(schoolId, branchId, substitutionId, request.resource.data);

          allow update: if canManageTimetable(schoolId, branchId) && validUpdateAudit()
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.dateKey == resource.data.dateKey
            && request.resource.data.timetableId == resource.data.timetableId
            && request.resource.data.slotId == resource.data.slotId
            && request.resource.data.originalTeacherId == resource.data.originalTeacherId
            && request.resource.data.revision == resource.data.revision + 1
            && substitutionDayBumped(schoolId, branchId, resource.data.dateKey)
            && substitutionHistoryOk(schoolId, branchId, substitutionId, request.resource.data)
            && (
              // change the substitute of an active cover
              (resource.data.status == 'ACTIVE' && request.resource.data.status == 'ACTIVE'
                && request.resource.data.lastEvent == 'CHANGED'
                && changedOnly(['substituteTeacherId', 'substituteTeacherName', 'reason', 'revision',
                                'lastEvent', 'updatedAt', 'updatedBy'])
                && validSubstituteTeacher(schoolId, branchId, request.resource.data))
              ||
              // cancel
              (resource.data.status == 'ACTIVE' && request.resource.data.status == 'CANCELLED'
                && request.resource.data.lastEvent == 'CANCELLED'
                && changedOnly(['status', 'cancelReason', 'revision', 'lastEvent', 'updatedAt', 'updatedBy'])
                && validFeeReason(request.resource.data.cancelReason))
              ||
              // reinstate a cancelled cover (with a new substitute) — only
              // while the timetable is still in force
              (resource.data.status == 'CANCELLED' && request.resource.data.status == 'ACTIVE'
                && request.resource.data.lastEvent == 'REINSTATED'
                && changedOnly(['substituteTeacherId', 'substituteTeacherName', 'reasonKind', 'reason',
                                'leaveApplicationId', 'status', 'cancelReason', 'revision', 'lastEvent',
                                'updatedAt', 'updatedBy'])
                && validSubstituteTeacher(schoolId, branchId, request.resource.data)
                && get(ttDoc(schoolId, branchId, 'timetables', resource.data.timetableId)).data.status == 'PUBLISHED')
            );
          allow delete: if false;
        }

        match /substitutionHistory/{entryId} {
          allow read: if canManageTimetable(schoolId, branchId);
          allow create: if canManageTimetable(schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && entryId == request.resource.data.substitutionId + '__' + string(request.resource.data.revision)
            && existsAfter(ttDoc(schoolId, branchId, 'substitutions', request.resource.data.substitutionId))
            && getAfter(ttDoc(schoolId, branchId, 'substitutions', request.resource.data.substitutionId)).data.revision
               == request.resource.data.revision;
          allow update, delete: if false;
        }

        // ---- Homework (Milestone 9) ------------------------------------
        match /homework/{homeworkId} {
          allow read: if canManageStaff(schoolId, branchId)
            || isOwnLeaveStaff(schoolId, branchId, resource.data.teacherStaffId)
            || (resource.data.status in ['PUBLISHED', 'CLOSED']
                && canReadSectionContent(schoolId, branchId, resource.data));

          allow create: if isActiveCaller() && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.batchId is string
            && homeworkId == request.resource.data.batchId + '__' + request.resource.data.sectionId
            && request.resource.data.status == 'DRAFT'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'CREATED'
            && request.resource.data.publishedBy == null
            && request.resource.data.teacherName is string
            && request.resource.data.subjectName is string
            && validHomeworkBody(request.resource.data)
            && homeworkSlotTeacherOk(schoolId, branchId, request.resource.data)
            && homeworkHistoryOk(schoolId, branchId, homeworkId, request.resource.data);

          allow update: if profileTeachesHomework(callerProfile(), schoolId, branchId, resource.data.teacherStaffId)
            // Everything not listed here — tenant, class, section, subject,
            // teacher, batch, marks, assigned date, creator — is immutable.
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                 'title', 'description', 'dueDateKey', 'dueTimeMin', 'dueAt', 'attachments',
                 'requiresSubmission', 'allowFiles', 'allowLate', 'allowResubmission',
                 'status', 'publishedBy', 'publishedAt', 'revision', 'lastEvent', 'updatedAt', 'updatedBy'])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.revision == resource.data.revision + 1
            && homeworkHistoryOk(schoolId, branchId, homeworkId, request.resource.data)
            && (
              // edit a draft
              (resource.data.status == 'DRAFT' && request.resource.data.status == 'DRAFT'
                && request.resource.data.lastEvent == 'EDITED'
                && changedOnly(['title', 'description', 'dueDateKey', 'dueTimeMin', 'dueAt', 'attachments',
                                'requiresSubmission', 'allowFiles', 'allowLate', 'allowResubmission',
                                'revision', 'lastEvent', 'updatedAt', 'updatedBy'])
                && validHomeworkBody(request.resource.data))
              ||
              // publish: the deadline is in the future, the author still holds
              // the assignment, and the broadcast notice is written with it
              (resource.data.status == 'DRAFT' && request.resource.data.status == 'PUBLISHED'
                && request.resource.data.lastEvent == 'PUBLISHED'
                && request.resource.data.publishedBy == request.auth.uid
                && request.resource.data.publishedAt == request.time
                && request.resource.data.dueAt > request.time
                && changedOnly(['status', 'publishedBy', 'publishedAt', 'revision', 'lastEvent',
                                'updatedAt', 'updatedBy'])
                && homeworkSlotNamesTeacher(schoolId, branchId, resource.data)
                && homeworkNoticeOk(schoolId, branchId, homeworkId, request.resource.data, 'PUBLISHED'))
              ||
              // extend the deadline of a published homework (never shorten)
              (resource.data.status == 'PUBLISHED' && request.resource.data.status == 'PUBLISHED'
                && request.resource.data.lastEvent == 'DUE_CHANGED'
                && changedOnly(['dueDateKey', 'dueTimeMin', 'dueAt', 'revision', 'lastEvent',
                                'updatedAt', 'updatedBy'])
                && validHomeworkBody(request.resource.data)
                && request.resource.data.dueAt >= resource.data.dueAt
                && homeworkNoticeOk(schoolId, branchId, homeworkId, request.resource.data, 'DUE_CHANGED'))
              ||
              // instructions / materials of a published homework; policy and
              // marks are fixed once students may have started
              (resource.data.status == 'PUBLISHED' && request.resource.data.status == 'PUBLISHED'
                && request.resource.data.lastEvent == 'EDITED'
                && changedOnly(['description', 'attachments', 'revision', 'lastEvent', 'updatedAt', 'updatedBy'])
                && request.resource.data.description is string && request.resource.data.description.size() <= 4000
                && request.resource.data.attachments is list && request.resource.data.attachments.size() <= 5)
              ||
              // close (submissions stop; grading continues)
              (resource.data.status == 'PUBLISHED' && request.resource.data.status == 'CLOSED'
                && request.resource.data.lastEvent == 'CLOSED'
                && changedOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
              ||
              // archive a draft or a closed homework
              (resource.data.status in ['DRAFT', 'CLOSED'] && request.resource.data.status == 'ARCHIVED'
                && request.resource.data.lastEvent == 'ARCHIVED'
                && changedOnly(['status', 'revision', 'lastEvent', 'updatedAt', 'updatedBy']))
            );
          allow delete: if false;
        }

        match /homeworkHistory/{entryId} {
          allow read: if canManageStaff(schoolId, branchId)
            || isOwnLeaveStaff(schoolId, branchId,
                 get(ttDoc(schoolId, branchId, 'homework', resource.data.homeworkId)).data.teacherStaffId);
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && entryId == request.resource.data.homeworkId + '__' + string(request.resource.data.revision)
            && existsAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.homeworkId))
            && getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.homeworkId)).data.revision
               == request.resource.data.revision;
          allow update, delete: if false;
        }

        // One submission per student per homework, by id. The current state
        // is here; every change also appends a revision.
        match /homeworkSubmissions/{submissionId} {
          // A child who has not submitted yet has no document and the app
          // reads it with get(): judge a missing one by the homework and
          // student its id names (homeworkId__studentId).
          allow read: if submissionReadable(schoolId, branchId,
            resource != null ? resource.data : submissionKeyData(submissionId));

          // a linked parent submits for a child placed in the homework's
          // class and section, before the deadline or (if allowed) late —
          // judged on the server clock
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && submissionCreateOk(schoolId, branchId, submissionId, request.resource.data)
            && submissionRevisionOk(schoolId, branchId, submissionId, request.resource.data);

          allow update: if isActiveCaller()
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.homeworkId == resource.data.homeworkId
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.classId == resource.data.classId
            && request.resource.data.sectionId == resource.data.sectionId
            && request.resource.data.academicYearId == resource.data.academicYearId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.revision == resource.data.revision + 1
            && submissionRevisionOk(schoolId, branchId, submissionId, request.resource.data)
            && (familyChangeOk(schoolId, branchId, resource.data, request.resource.data)
                || reviewerChangeOk(schoolId, branchId, resource.data, request.resource.data));
          allow delete: if false;
        }

        // Append-only: what the student wrote, what the teacher said, when.
        match /homeworkRevisions/{revisionId} {
          allow read: if canManageStaff(schoolId, branchId)
            || isOwnLeaveStaff(schoolId, branchId,
                 get(ttDoc(schoolId, branchId, 'homework', resource.data.homeworkId)).data.teacherStaffId)
            || canAccessAsParent(schoolId, branchId, resource.data.studentId);
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && revisionId == request.resource.data.submissionId + '__' + string(request.resource.data.revision)
            && existsAfter(ttDoc(schoolId, branchId, 'homeworkSubmissions', request.resource.data.submissionId))
            && getAfter(ttDoc(schoolId, branchId, 'homeworkSubmissions', request.resource.data.submissionId)).data.revision
               == request.resource.data.revision
            && getAfter(ttDoc(schoolId, branchId, 'homeworkSubmissions', request.resource.data.submissionId)).data.status
               == request.resource.data.status;
          allow update, delete: if false;
        }

        // ---- Announcements (Milestone 9) -------------------------------
        match /announcements/{announcementId} {
          allow read: if isAnnouncementAuthorOrManager(schoolId, branchId, resource.data.authorId)
            || (resource.data.status == 'PUBLISHED' && isActiveCaller() && callerSchoolId() == schoolId
                && ((callerRoleIn(branchId) in ['TEACHER', 'FINANCE'])
                    || (callerRole() == 'PARENT' && parentMayReadAudience(schoolId, branchId, resource.data))));

          allow create: if isActiveCaller() && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.status == 'DRAFT'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'CREATED'
            && request.resource.data.publishedBy == null
            && request.resource.data.audienceKind in ['ALL', 'BRANCH', 'STAFF', 'PARENTS', 'CLASS', 'SECTION']
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 120
            && request.resource.data.body is string
            && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 4000
            && request.resource.data.attachments is list && request.resource.data.attachments.size() <= 5
            && canAddressAudience(schoolId, branchId, request.resource.data)
            && announcementHistoryOk(schoolId, branchId, announcementId, request.resource.data);

          allow update: if isActiveCaller()
            && announcementUpdateOk(schoolId, branchId, announcementId, resource.data, request.resource.data);
          allow delete: if false;
        }

        match /announcementHistory/{entryId} {
          allow read: if canManageStaff(schoolId, branchId)
            || (isActiveCaller()
                && get(ttDoc(schoolId, branchId, 'announcements', resource.data.announcementId)).data.authorId
                   == request.auth.uid);
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && entryId == request.resource.data.announcementId + '__' + string(request.resource.data.revision)
            && existsAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.announcementId))
            && getAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.announcementId)).data.revision
               == request.resource.data.revision;
          allow update, delete: if false;
        }

        // Audience-addressed in-app notices: ONE document per event (homework
        // published / deadline changed / announcement published or updated),
        // written in that event's commit with a deterministic id. Recipients
        // resolve them on read from their own relationships; no per-recipient
        // fan-out. Only a title, a short line and a reference — never work or
        // feedback.
        match /broadcastNotices/{noticeId} {
          allow read: if isActiveCaller() && callerSchoolId() == schoolId
            && (canManageStaff(schoolId, branchId)
                || (callerRoleIn(branchId) in ['TEACHER', 'FINANCE'])
                || (callerRole() == 'PARENT' && parentMayReadAudience(schoolId, branchId, resource.data)));
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.revision is int
            && (
              (request.resource.data.type in ['HOMEWORK_PUBLISHED', 'HOMEWORK_DUE_CHANGED']
                && request.resource.data.refType == 'HOMEWORK'
                && request.resource.data.audienceKind == 'SECTION'
                && existsAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId))
                && noticeId == request.resource.data.refId + '__'
                     + getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId)).data.lastEvent
                     + '__' + string(request.resource.data.revision)
                && getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId)).data.revision
                   == request.resource.data.revision
                && getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId)).data.status == 'PUBLISHED'
                && getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId)).data.classId
                   == request.resource.data.classId
                && getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId)).data.sectionId
                   == request.resource.data.sectionId
                && getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId)).data.updatedBy
                   == request.auth.uid
                && {'PUBLISHED': 'HOMEWORK_PUBLISHED', 'DUE_CHANGED': 'HOMEWORK_DUE_CHANGED'}[
                     getAfter(ttDoc(schoolId, branchId, 'homework', request.resource.data.refId)).data.lastEvent]
                   == request.resource.data.type)
              ||
              // result published: tied to the examination's own publish commit
              (request.resource.data.type == 'RESULT_PUBLISHED'
                && request.resource.data.refType == 'EXAM'
                && request.resource.data.audienceKind in ['CLASS', 'SECTION']
                && existsAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.refId))
                && getAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.refId)).data.status
                   == 'PUBLISHED'
                && request.resource.data.revision
                   == getAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.refId)).data.resultVersion
                && noticeId == request.resource.data.refId + '__PUBLISHED__' + string(request.resource.data.revision)
                && getAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.refId)).data.publishedBy
                   == request.auth.uid
                && getAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.refId)).data.classId
                   == request.resource.data.classId)
              ||
              (request.resource.data.type in ['ANNOUNCEMENT_PUBLISHED', 'ANNOUNCEMENT_UPDATED']
                && request.resource.data.refType == 'ANNOUNCEMENT'
                && existsAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.refId))
                && noticeId == request.resource.data.refId + '__'
                     + getAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.refId)).data.lastEvent
                     + '__' + string(request.resource.data.revision)
                && getAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.refId)).data.revision
                   == request.resource.data.revision
                && getAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.refId)).data.status == 'PUBLISHED'
                && getAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.refId)).data.audienceKind
                   == request.resource.data.audienceKind
                && getAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.refId)).data.updatedBy
                   == request.auth.uid
                && {'PUBLISHED': 'ANNOUNCEMENT_PUBLISHED', 'UPDATED': 'ANNOUNCEMENT_UPDATED'}[
                     getAfter(ttDoc(schoolId, branchId, 'announcements', request.resource.data.refId)).data.lastEvent]
                   == request.resource.data.type)
            );
          allow update, delete: if false;
        }
        // ---- Examinations, marks and results (Milestone 10) -------------
        match /gradingSchemes/{schemeId} {
          allow read: if canManageStaff(schoolId, branchId)
            || callerIsInBranchAs(schoolId, branchId, 'TEACHER');
          allow create: if profileManages(callerProfile(), schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.revision == 1
            && request.resource.data.name is string && request.resource.data.name.size() >= 2
            && request.resource.data.bands is list && request.resource.data.bands.size() >= 1
            && request.resource.data.bands.size() <= 20
            && request.resource.data.decimals is int && request.resource.data.decimals >= 0
            && request.resource.data.decimals <= 3
            && request.resource.data.passPercent is number
            && request.resource.data.passPercent >= 0 && request.resource.data.passPercent <= 100
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          allow update: if profileManages(callerProfile(), schoolId, branchId) && validUpdateAudit()
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.branchId == resource.data.branchId
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.bands is list && request.resource.data.bands.size() >= 1
            && request.resource.data.bands.size() <= 20
            && request.resource.data.decimals is int && request.resource.data.decimals >= 0
            && request.resource.data.decimals <= 3
            && request.resource.data.passPercent is number
            && request.resource.data.passPercent >= 0 && request.resource.data.passPercent <= 100
            && request.resource.data.status in ['ACTIVE', 'INACTIVE'];
          allow delete: if false;
        }

        match /examinations/{examId} {
          allow read: if canManageStaff(schoolId, branchId)
            || callerIsInBranchAs(schoolId, branchId, 'TEACHER')
            || (resource.data.status == 'PUBLISHED'
                && (resource.data.sectionId == null
                    ? parentHasClass(schoolId, branchId, resource.data.classId)
                    : parentHasSection(schoolId, branchId, resource.data.classId, resource.data.sectionId)));

          allow create: if profileManages(callerProfile(), schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.status == 'DRAFT'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'CREATED'
            && request.resource.data.subjectCount == 0
            && request.resource.data.sheetCount == 0
            && request.resource.data.approvedSheets == 0
            && request.resource.data.resultVersion == 0
            && request.resource.data.resultCount == 0
            && request.resource.data.resultsWritten == 0
            && request.resource.data.schemeSnapshot == null
            && request.resource.data.publishedBy == null
            && request.resource.data.nameSlug is string
            && request.resource.data.nameSlug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
            && examId == request.resource.data.academicYearId + '__' + request.resource.data.classId
                 + '__' + (request.resource.data.sectionId == null ? 'ALL' : request.resource.data.sectionId)
                 + '__' + request.resource.data.nameSlug
            && validExamBody(request.resource.data)
            && (request.resource.data.sectionId == null
                || exists(sectionPath(schoolId, branchId, request.resource.data.academicYearId,
                     request.resource.data.classId, request.resource.data.sectionId)))
            && examHistoryOk(schoolId, branchId, examId, request.resource.data);

          allow update: if examUpdateOk(schoolId, branchId, examId, resource.data, request.resource.data);
          allow delete: if false;
        }

        match /examHistory/{entryId} {
          allow read: if canManageStaff(schoolId, branchId);
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && entryId == request.resource.data.examId + '__' + string(request.resource.data.revision)
            && existsAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId))
            && getAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.revision
               == request.resource.data.revision;
          allow update, delete: if false;
        }

        match /examinationSubjects/{subjectDocId} {
          allow read: if canManageStaff(schoolId, branchId)
            || callerIsInBranchAs(schoolId, branchId, 'TEACHER')
            || (isActiveCaller() && callerSchoolId() == schoolId && callerRole() == 'PARENT'
                && get(ttDoc(schoolId, branchId, 'examinations', resource.data.examId)).data.status == 'PUBLISHED');

          allow create: if profileManages(callerProfile(), schoolId, branchId) && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && subjectDocId == request.resource.data.examId + '__' + request.resource.data.subjectId
            && request.resource.data.revision == 1
            && get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.status
               in ['DRAFT', 'SCHEDULED']
            && request.resource.data.academicYearId
               == get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.academicYearId
            && request.resource.data.classId
               == get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.classId
            && exists(classSubjectPath(schoolId, branchId, request.resource.data.academicYearId,
                 request.resource.data.classId, request.resource.data.subjectId))
            && validSubjectConfig(request.resource.data)
            && getAfter(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.subjectCount
               == get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.subjectCount + 1;

          allow update: if profileManages(callerProfile(), schoolId, branchId) && validUpdateAudit()
            && get(ttDoc(schoolId, branchId, 'examinations', resource.data.examId)).data.status
               in ['DRAFT', 'SCHEDULED']
            && request.resource.data.revision == resource.data.revision + 1
            && changedOnly(['subjectName', 'maxMarks', 'passMarks', 'weightage', 'dateKey', 'startMin',
                            'endMin', 'theoryMax', 'practicalMax', 'revision', 'updatedAt', 'updatedBy'])
            && validSubjectConfig(request.resource.data);

          allow delete: if profileManages(callerProfile(), schoolId, branchId)
            && get(ttDoc(schoolId, branchId, 'examinations', resource.data.examId)).data.status
               in ['DRAFT', 'SCHEDULED']
            && getAfter(ttDoc(schoolId, branchId, 'examinations', resource.data.examId)).data.subjectCount
               == get(ttDoc(schoolId, branchId, 'examinations', resource.data.examId)).data.subjectCount - 1;
        }

        // One subject's marks in one section, with its review state.
        match /marksSheets/{sheetId} {
          // Same missing-document rule as attendanceSessions: a sheet that has
          // not been created yet is judged by the section/subject its id names
          // (examId__subjectId__sectionId) and the exam's own year and class.
          allow read: if canManageStaff(schoolId, branchId)
            || profileMayEnterMarks(callerProfile(), schoolId, branchId,
                 resource != null ? resource.data : sheetKeyData(schoolId, branchId, sheetId));

          allow create: if isActiveCaller() && validCreateAudit()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && sheetId == request.resource.data.examId + '__' + request.resource.data.subjectId
                 + '__' + request.resource.data.sectionId
            && request.resource.data.status == 'DRAFT'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'SAVED'
            && request.resource.data.submittedBy == null
            && request.resource.data.approvedBy == null
            && request.resource.data.rosterCount is int && request.resource.data.rosterCount >= 0
            && get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.status
               == 'IN_PROGRESS'
            && request.resource.data.academicYearId
               == get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.academicYearId
            && request.resource.data.classId
               == get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.classId
            && exists(ttDoc(schoolId, branchId, 'examinationSubjects',
                 request.resource.data.examId + '__' + request.resource.data.subjectId))
            && profileMayEnterMarks(callerProfile(), schoolId, branchId, request.resource.data)
            && sheetHistoryOk(schoolId, branchId, sheetId, request.resource.data);

          allow update: if sheetUpdateOk(schoolId, branchId, sheetId, resource.data, request.resource.data);
          allow delete: if false;
        }

        match /marksSheetHistory/{entryId} {
          allow read: if canManageStaff(schoolId, branchId);
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && entryId == request.resource.data.sheetId + '__' + string(request.resource.data.revision)
            && getAfter(ttDoc(schoolId, branchId, 'marksSheets', request.resource.data.sheetId)).data.revision
               == request.resource.data.revision;
          allow update, delete: if false;
        }

        match /marksEntries/{entryId} {
          allow read: if canManageStaff(schoolId, branchId)
            || profileMayEnterMarks(callerProfile(), schoolId, branchId, resource.data);

          allow create: if isActiveCaller() && validCreateAudit()
            && entryId == request.resource.data.sheetId + '__' + request.resource.data.studentId
            && request.resource.data.revision == 1
            && entryContextOk(schoolId, branchId, request.resource.data)
            && entryRevisionOk(schoolId, branchId, entryId, request.resource.data);

          allow update: if isActiveCaller()
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['status', 'marks', 'theory', 'practical', 'remark', 'revision', 'updatedAt', 'updatedBy'])
            && entryContextOk(schoolId, branchId, request.resource.data)
            && entryRevisionOk(schoolId, branchId, entryId, request.resource.data);
          allow delete: if false;
        }

        match /marksRevisions/{revisionId} {
          allow read: if canManageStaff(schoolId, branchId)
            || profileMayEnterMarks(callerProfile(), schoolId, branchId, resource.data);
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && revisionId == request.resource.data.entryId + '__' + string(request.resource.data.revision)
            && existsAfter(ttDoc(schoolId, branchId, 'marksEntries', request.resource.data.entryId))
            && getAfter(ttDoc(schoolId, branchId, 'marksEntries', request.resource.data.entryId)).data.revision
               == request.resource.data.revision;
          allow update, delete: if false;
        }

        // Remarks typed before finalisation (copied into the result then).
        match /examRemarks/{remarkId} {
          allow read: if canManageStaff(schoolId, branchId)
            || callerIsInBranchAs(schoolId, branchId, 'TEACHER');
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && remarkId == request.resource.data.examId + '__' + request.resource.data.studentId
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.teacherRemark is string && request.resource.data.teacherRemark.size() <= 300
            && request.resource.data.principalRemark is string && request.resource.data.principalRemark.size() <= 300
            && get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.status
               == 'IN_PROGRESS'
            && (profileManages(callerProfile(), schoolId, branchId)
                || (request.resource.data.principalRemark == ''
                    && isClassTeacherOf(schoolId, branchId, request.resource.data.academicYearId,
                         request.resource.data.classId, request.resource.data.sectionId)));
          allow update: if isActiveCaller()
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.examId == resource.data.examId
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.teacherRemark is string && request.resource.data.teacherRemark.size() <= 300
            && request.resource.data.principalRemark is string && request.resource.data.principalRemark.size() <= 300
            && get(ttDoc(schoolId, branchId, 'examinations', resource.data.examId)).data.status
               == 'IN_PROGRESS'
            && (profileManages(callerProfile(), schoolId, branchId)
                || (request.resource.data.principalRemark == resource.data.principalRemark
                    && isClassTeacherOf(schoolId, branchId, resource.data.academicYearId,
                         resource.data.classId, resource.data.sectionId)));
          allow delete: if false;
        }

        // Finalised, versioned, create-only results.
        match /resultSummaries/{resultId} {
          // A result that has not been calculated yet does not exist; judge a
          // missing one by the exam/student/version its id names
          // (examId__studentId__v<version>).
          allow read: if resultReadable(schoolId, branchId,
            resource != null ? resource.data : resultKeyData(resultId));

          allow create: if profileManages(callerProfile(), schoolId, branchId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.calculatedBy == request.auth.uid
            && request.resource.data.calculatedAt == request.time
            && resultId == request.resource.data.examId + '__' + request.resource.data.studentId
                 + '__v' + string(request.resource.data.version)
            && request.resource.data.summary is map
            && request.resource.data.schemeSnapshot is map
            && get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.status
               == 'COMPLETED'
            && get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.resultVersion
               == request.resource.data.version
            && request.resource.data.academicYearId
               == get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.academicYearId
            && request.resource.data.classId
               == get(ttDoc(schoolId, branchId, 'examinations', request.resource.data.examId)).data.classId;
          allow update, delete: if false;
        }

        // ---- Parent–teacher conversations (Milestone 11) -----------------
        match /conversations/{conversationId} {
          allow read: if isActiveCaller()
            && (request.auth.uid in resource.data.participants
                || (resource.data.flagged == true && profileManages(callerProfile(), schoolId, branchId)));

          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.parentUserId == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.participants == [request.resource.data.parentUserId,
                 request.resource.data.teacherUserId]
            && request.resource.data.parentUserId != request.resource.data.teacherUserId
            && request.resource.data.status == 'OPEN'
            && request.resource.data.revision == 1
            && request.resource.data.lastEvent == 'OPENED'
            && request.resource.data.flagged == false
            && request.resource.data.messageCount == 1
            && request.resource.data.unreadForTeacher == 1
            && request.resource.data.unreadForParent == 0
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 80
            && profileIsLinkedParent(callerProfile(), schoolId, branchId, request.resource.data.studentId)
            && get(ttDoc(schoolId, branchId, 'students', request.resource.data.studentId)).data.status == 'ACTIVE'
            && get(ttDoc(schoolId, branchId, 'students', request.resource.data.studentId)).data.currentSectionId
               == request.resource.data.sectionId
            && get(ttDoc(schoolId, branchId, 'students', request.resource.data.studentId)).data.currentClassId
               == request.resource.data.classId
            && get(ttDoc(schoolId, branchId, 'students', request.resource.data.studentId)).data.currentAcademicYearId
               == request.resource.data.academicYearId
            && convTeacherOk(callerProfile(), schoolId, branchId, request.resource.data)
            && get(ttDoc(schoolId, branchId, 'messageContacts', request.resource.data.teacherStaffId)).data.enabled == true
            && existsAfter(convMessagePath(schoolId, branchId, conversationId,
                 request.resource.data.lastMessageId))
            && getAfter(convMessagePath(schoolId, branchId, conversationId,
                 request.resource.data.lastMessageId)).data.senderUserId == request.auth.uid
            && convEventOk(schoolId, branchId, conversationId, request.resource.data);

          allow update: if conversationUpdateOk(schoolId, branchId, conversationId, resource.data, request.resource.data);
          allow delete: if false;

          match /messages/{messageId} {
            allow read: if isActiveCaller()
              && (request.auth.uid in get(ttDoc(schoolId, branchId, 'conversations', conversationId)).data.participants
                  || (get(ttDoc(schoolId, branchId, 'conversations', conversationId)).data.flagged == true
                      && profileManages(callerProfile(), schoolId, branchId)));

            allow create: if isActiveCaller()
              && request.resource.data.schoolId == schoolId
              && request.resource.data.branchId == branchId
              && request.resource.data.senderUserId == request.auth.uid
              && request.resource.data.createdAt == request.time
              && request.auth.uid in getAfter(ttDoc(schoolId, branchId, 'conversations', conversationId)).data.participants
              && getAfter(ttDoc(schoolId, branchId, 'conversations', conversationId)).data.status == 'OPEN'
              && getAfter(ttDoc(schoolId, branchId, 'conversations', conversationId)).data.lastMessageId == messageId
              && messageBodyOk(request.resource.data);
            allow update, delete: if false;
          }
        }

        match /conversationEvents/{eventId} {
          allow read: if isActiveCaller()
            && (request.auth.uid in get(ttDoc(schoolId, branchId, 'conversations', resource.data.conversationId)).data.participants
                || profileManages(callerProfile(), schoolId, branchId));
          allow create: if isActiveCaller()
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.at == request.time
            && eventId == request.resource.data.conversationId + '__' + string(request.resource.data.revision)
            && getAfter(ttDoc(schoolId, branchId, 'conversations', request.resource.data.conversationId)).data.revision
               == request.resource.data.revision;
          allow update, delete: if false;
        }

        // A teacher's opt-in to being messaged by parents, and where they teach
        // (so a parent can find them). Written only by the teacher; the
        // conversation rule still checks the real assignment slot, so what is
        // listed here is a convenience, never an authorisation.
        match /messageContacts/{staffId} {
          allow read: if isActiveCaller() && callerSchoolId() == schoolId
            && (canManageStaff(schoolId, branchId)
                || (callerRole() == 'PARENT' && resource.data.enabled == true)
                || (callerRoleIn(branchId) == 'TEACHER'));
          allow create, update: if profileOwnsStaff(callerProfile(), schoolId, branchId, staffId)
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.staffId == staffId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.enabled is bool
            && request.resource.data.name is string && request.resource.data.name.size() <= 120
            && request.resource.data.sectionKeys is list && request.resource.data.sectionKeys.size() <= 60
            && request.resource.data.scopes is list && request.resource.data.scopes.size() <= 120
            && request.resource.data.updatedAt == request.time;
          allow delete: if false;
        }

        // Targeted new-message notifications (their own match, OR-ed with the
        // leave/timetable/homework rules; no message text in the notice).
        match /notifications/{notificationId} {
          allow create: if isActiveCaller()
            && request.resource.data.type == 'MESSAGE_RECEIVED'
            && request.resource.data.schoolId == schoolId
            && request.resource.data.branchId == branchId
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.audience == 'USER'
            && request.resource.data.readAt == null
            && messageNotificationOk(schoolId, branchId, notificationId, request.resource.data);
        }

      }
    }

    // Which broadcast notices a user has read: one small document of their
    // own, under their own user id.
    match /users/{userId}/noticeReads/{docId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.ids is list && request.resource.data.ids.size() <= 500;
    }

    // Notification preferences (Milestone 11): the user's own document. A
    // category may be muted unless it is critical (administrative notices
    // cannot be silenced); pushEnabled is the user's own on/off for push.
    match /users/{userId}/preferences/{docId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId
        && docId == 'notifications'
        && request.resource.data.mutedCategories is list
        && request.resource.data.mutedCategories.size() <= 12
        && request.resource.data.mutedCategories.hasOnly([
             'ANNOUNCEMENT', 'HOMEWORK', 'RESULTS', 'ATTENDANCE', 'LEAVE', 'FEES', 'TIMETABLE', 'MESSAGES'])
        && request.resource.data.pushEnabled is bool
        && request.resource.data.updatedAt == request.time;
    }

    // Push devices: one document per device under the user's own id, holding
    // the FCM token. Only the owner may read or write it; the Cloud Function
    // that sends push reads it with admin credentials.
    match /users/{userId}/devices/{deviceId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20 && request.resource.data.token.size() <= 4096
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.updatedAt == request.time;
    }

    // Roster queries (Milestone 5): "who was enrolled in this section", across
    // students, is a collection-group query over academicRecords. Same read
    // rule as the nested path (viewStudentData), judged on the record's own
    // schoolId/branchId so it cannot cross a tenant.
    match /{path=**}/academicRecords/{recordId} {
      allow read: if canViewStudentData(resource.data.schoolId, resource.data.branchId)
        // A teacher's roster query pins school, branch, class and section.
        || teacherHasSection(resource.data.schoolId, resource.data.branchId, resource.data.classId, resource.data.sectionId);
    }

    // Parent -> children lookup (ParentRepository.getChildrenForParent): a
    // collection-group query over parentLinks. A PARENT may read only links
    // that name their own linked parent record, in their own school.
    match /{path=**}/parentLinks/{parentId} {
      allow read: if (isActiveCaller() && callerRole() == 'PARENT'
          && callerSchoolId() == resource.data.schoolId
          && callerProfile().linkedParentId == resource.data.parentId)
        // Staff who may read the nested link may run the same lookup for one
        // branch (used to refresh parentAccess). Same visibility, same tenant.
        || canViewStudentData(resource.data.schoolId, resource.data.branchId);
    }

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
