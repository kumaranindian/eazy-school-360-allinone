        {
          "as": "cc-t1",
          "label": "teacher opts in to parent messages",
          "ops": [
            {
              "op": "set",
              "path": "messageContacts/st1",
              "data": {
                "schoolId": "__SCHOOL__",
                "branchId": "north",
                "staffId": "st1",
                "userId": "cc-t1",
                "name": "Teacher",
                "enabled": true,
                "sectionKeys": [
                  "y1__c5__sa"
                ],
                "scopes": [
                  "y1__c5__sa__math"
                ],
                "subjectNames": {
                  "y1__c5__sa__math": "Maths"
                },
                "updatedAt": {
                  "$serverTimestamp": true
                }
              }
            }
          ]
        }
      ]
    },
