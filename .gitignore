# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase client options (lib/core/config/firebase_options/) are NOT ignored:
# they are public client identifiers, and a clean checkout (CI) must compile.
# The committed files hold placeholders until the owner configures each
# environment - see docs/milestone-12a-blocker-closure.md.
**/google-services.json
**/GoogleService-Info.plist
.firebaserc

# Firestore rules test tooling (Node) — see firestore-tests/package.json
firestore-tests/node_modules/
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/

# Release signing material and local secrets - never commit
android/key.properties
android/app/*.jks
android/app/*.keystore
**/*.jks
**/*.keystore
.env
.env.*
firebase-debug.log
firestore-debug.log
ui-debug.log

