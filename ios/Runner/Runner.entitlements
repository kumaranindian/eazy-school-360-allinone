<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. "development" here; Xcode signs App Store
	     / TestFlight builds with the production value from the provisioning
	     profile. Requires the Push Notifications capability on the App ID and an
	     APNs key uploaded in Firebase (see docs/push-notifications.md). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
